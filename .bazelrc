build --cxxopt='-std=c++17'
build --linkopt=-lstdc++
build --repo_env=CC=g++
build --repo_env=CXX=g++
build --action_env=CC=g++
build --action_env=CXX=g++
build --action_env=BAZEL_COMPILER=gcc

# Enable legacy runfiles for Python binaries (needed for node_generator)
build --legacy_external_runfiles
build --enable_runfiles

# Use system Python entirely for ROS2 compatibility
# System Python already has rclpy, numpy, and all ROS2 dependencies

# =============================================================================
# OS / ROS2 Configurations
# =============================================================================

# Ubuntu 22.04 (Humble) + Python 3.10
# Note: PYTHONPATH is set to allow Hermetic Python to find System ROS2 packages (rclpy)
build:u22 --action_env=PYTHONPATH=/opt/ros/humble/lib/python3.10/site-packages:/opt/ros/humble/local/lib/python3.10/dist-packages
run:u22 --action_env=PYTHONPATH=/opt/ros/humble/lib/python3.10/site-packages:/opt/ros/humble/local/lib/python3.10/dist-packages
test:u22 --action_env=PYTHONPATH=/opt/ros/humble/lib/python3.10/site-packages:/opt/ros/humble/local/lib/python3.10/dist-packages

# Ubuntu 24.04 (Jazzy) + Python 3.12
# Note: PYTHONPATH is set to allow Hermetic Python to find System ROS2 packages (rclpy)
build:u24 --action_env=PYTHONPATH=/opt/ros/jazzy/lib/python3.12/site-packages:/opt/ros/jazzy/local/lib/python3.12/dist-packages
run:u24 --action_env=PYTHONPATH=/opt/ros/jazzy/lib/python3.12/site-packages:/opt/ros/jazzy/local/lib/python3.12/dist-packages
test:u24 --action_env=PYTHONPATH=/opt/ros/jazzy/lib/python3.12/site-packages:/opt/ros/jazzy/local/lib/python3.12/dist-packages

test --test_output=all

# =============================================================================
# Base Platform Configurations
# =============================================================================

# ARM64 Base Configuration
build:arm64 --config=arm64-base

build:arm64-base --cpu=arm64
build:arm64-base --experimental_cc_static_library
build:arm64-base --features=-static_link_cpp_runtimes
build:arm64-base --dynamic_mode=fully
build:arm64-base --copt='-fPIC'
build:arm64-base --copt='-ftls-model=global-dynamic'
# build:arm64-base --@toolchains_llvm_bootstrapped//config:empty_sysroot=False

# x86_64 Base Configuration
build:x86 --config=x86-base

build:x86-base --cpu=k8
build:x86-base --copt='-fPIC'

# =============================================================================
# Specific Platform Configurations
# =============================================================================

# NVIDIA Jetson Orin Nano (ARM64)
build:jetson-orin-nano --config=arm64-base
build:jetson-orin-nano --platforms=//:jetson_orin_nano

# ARM64 Cross-compilation with System ROS2
# Use this when building with system ROS2 libraries for ARM64
build:arm64-ros2 --config=arm64-base
build:arm64-ros2 --linkopt='-L/opt/ros/humble/lib/aarch64-linux-gnu'
build:arm64-ros2 --linkopt='-L/usr/lib/aarch64-linux-gnu'
build:arm64-ros2 --linkopt='-Wl,-rpath,/opt/ros/humble/lib/aarch64-linux-gnu'
build:arm64-ros2 --linkopt='-Wl,-rpath,/usr/lib/aarch64-linux-gnu'

# Add more platforms here as needed:
# build:raspberry-pi --config=arm64-base
# build:jetson-xavier --config=arm64-base
# build:intel-nuc --config=x86-base
# build:amd-desktop --config=x86-base
