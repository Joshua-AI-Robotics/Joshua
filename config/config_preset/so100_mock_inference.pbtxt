    }
    single_actions {
      node_id: 1
      subscribe_topic: "mock_action_6"
      action_type: ACTUATOR
      actuator {
        actuator_name: "sts_motor_6"
        id: 6
        actuator_type: STS3215_SERVO
        comm {
          comm_type: SERIAL
