  }

  perceptions {
    single_perceptions {
      node_id: 2
      publish_topic: "camera_1"
      perception_type: CAMERA
      publish_rate_hz: 30
      camera {
        camera_name: "webcam"
        id: 1
        camera_type: OPENCV
        comm{}
        opencv_config {
          id: 0
          width: 640
          height: 480
          fps: 30
        }
      }
    }
  }
}

ai {
  models {
    single_model {
      policy_name: "example_policy"
      node_id: 3

      subscriptions {
        ros2_data_type: IMAGE
        topic: "camera_1"
      }

      pubishers {
        ros2_data_type: FLOAT32
        topic: "mock_action_1"
      }
      pubishers {
        ros2_data_type: FLOAT32
        topic: "mock_action_2"
      }
      pubishers {
        ros2_data_type: FLOAT32
        topic: "mock_action_3"
      }
      pubishers {
        ros2_data_type: FLOAT32
        topic: "mock_action_4"
      }
      pubishers {
        ros2_data_type: FLOAT32
        topic: "mock_action_5"
      }
      pubishers {
        ros2_data_type: FLOAT32
        topic: "mock_action_6"
      }

      example_policy_config {
        hidden_size: 256
        n_layer: 4
        n_head: 4
        activation_function: "relu"
        dropout: 0.1
        n_inner: 1024
        context_length: 20
        vision_embedding_dim: 128
      }
    }
  }
}
