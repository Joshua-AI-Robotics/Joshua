general{
  operation_mode: MODE_MOCK_INFERENCE
}
robot {
  name: "so100"
  id: 1
  robot_type: MANIPULATOR_ARM

  actions {
    single_actions {
      node_id: 1
      subscribe_topic: "mock_action_1"
      action_type: ACTUATOR
      actuator {
        actuator_name: "sts_motor_1"
        id: 1
        actuator_type: STS3215_SERVO
        comm {
          comm_type: SERIAL
          serial_config {
            id: 1
            port: "/dev/ttyACM0"
            baudrate: 1000000
          }
        }
        physical_lower_limit: 0
        physical_upper_limit: 4095
        operational_lower_limit: 973
        operational_upper_limit: 3034
        encoder_data_mode: ENCODER_DATA_MODE_NORMALIZED_MINUS_ONE_TO_ONE
        sts3215_config {
          servo_id: 1
          move_time_in_ms: 40
          move_speed: 1500
          idle_position: 2070
        }
      }
    }
    single_actions {
      node_id: 1
      subscribe_topic: "mock_action_2"
      action_type: ACTUATOR
      actuator {
        actuator_name: "sts_motor_2"
        id: 2
        actuator_type: STS3215_SERVO
        comm {
          comm_type: SERIAL
          serial_config {
            id: 2
            port: "/dev/ttyACM0"
            baudrate: 1000000
          }
        }
        physical_lower_limit: 0
        physical_upper_limit: 4095
        operational_lower_limit: 858
        operational_upper_limit: 3154
        encoder_data_mode: ENCODER_DATA_MODE_NORMALIZED_MINUS_ONE_TO_ONE
        sts3215_config {
          servo_id: 2
          move_time_in_ms: 40
          move_speed: 1500
          idle_position: 847
        }
      }
    }
    single_actions {
      node_id: 1
      subscribe_topic: "mock_action_3"
      action_type: ACTUATOR
      actuator {
        actuator_name: "sts_motor_3"
        id: 3
        actuator_type: STS3215_SERVO
        comm {
          comm_type: SERIAL
          serial_config {
            id: 3
            port: "/dev/ttyACM0"
            baudrate: 1000000
          }
        }
        physical_lower_limit: 0
         physical_upper_limit: 4095
        operational_lower_limit: 798
        operational_upper_limit: 3015
        encoder_data_mode: ENCODER_DATA_MODE_NORMALIZED_MINUS_ONE_TO_ONE
        sts3215_config {
          servo_id: 3
          move_time_in_ms: 40
          move_speed: 1500
          idle_position: 3011
        }
      }
    }
    single_actions {
      node_id: 1
      subscribe_topic: "mock_action_4"
      action_type: ACTUATOR
      actuator {
        actuator_name: "sts_motor_4"
        id: 4
        actuator_type: STS3215_SERVO
        comm {
          comm_type: SERIAL
          serial_config {
            id: 4
            port: "/dev/ttyACM0"
            baudrate: 1000000
          }
        }
        physical_lower_limit: 0
        physical_upper_limit: 4095
        operational_lower_limit: 668
        operational_upper_limit: 3124
        encoder_data_mode: ENCODER_DATA_MODE_NORMALIZED_MINUS_ONE_TO_ONE
        sts3215_config {
          servo_id: 4
          move_time_in_ms: 40
          move_speed: 1500
          idle_position: 655
        }
      }
    }
    single_actions {
      node_id: 1
      subscribe_topic: "mock_action_5"
      action_type: ACTUATOR
      actuator {
        actuator_name: "sts_motor_5"
        id: 5
        actuator_type: STS3215_SERVO
        comm {
          comm_type: SERIAL
          serial_config {
            id: 5
            port: "/dev/ttyACM0"
            baudrate: 1000000
          }
        }
        physical_lower_limit: 0
        physical_upper_limit: 4095
        operational_lower_limit: 902
