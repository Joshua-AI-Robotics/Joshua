general{
  operation_mode: MODE_CALIBRATION
}
robot {
  name: "so100"
  id: 1
  robot_type: MANIPULATOR_ARM

  perceptions {
    single_perceptions {
      node_id: 1
      publish_topic: "sts3215_encoder_1"
      perception_type: ENCODER
      publish_rate_hz: 100
      encoder {
        encoder_name: "sts3215_encoder_1"
        id: 1
        encoder_type: STS3215_ENCODER
        comm {
          comm_type: SERIAL
          serial_config {
            id: 1
            port: "/dev/ttyACM1"
            baudrate: 1000000
          }
        }
        operational_lower_limit: 973
        operational_upper_limit: 3034
        encoder_data_mode: ENCODER_DATA_MODE_RAW
        sts3215_encoder_config {
          servo_id: 1
        }
      }
    }
    single_perceptions {
      node_id: 1
      publish_topic: "sts3215_encoder_2"
