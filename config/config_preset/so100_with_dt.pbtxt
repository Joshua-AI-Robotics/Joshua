          operational_upper_limit: 3000
          move_time_in_ms: 40
          move_speed: 1500
          idle_position: 3011
        }
      }
    }
    single_actuation {
      actuator {
        actuator_name: "sts_motor_4"
        id: 4
        actuation_type: STS3215
        comm_type: SERIAL
        serial_config {
          id: 4
          port: "/dev/ttyACM0"
          baudrate: 1000000
        }
        sts3215_config {
          id: 4
          physical_lower_limit: 0
          physical_upper_limit: 4095
          operational_lower_limit: 900
          operational_upper_limit: 3072
          move_time_in_ms: 40
          move_speed: 1500
          idle_position: 655
        }
      }
    }
    single_actuation {
      actuator {
        actuator_name: "sts_motor_5"
        id: 5
        actuation_type: STS3215
        comm_type: SERIAL
        serial_config {
          id: 5
          port: "/dev/ttyACM0"
          baudrate: 1000000
        }
        sts3215_config {
          id: 5
          physical_lower_limit: 0
          physical_upper_limit: 4095
          operational_lower_limit: 10
          operational_upper_limit: 3000
          move_time_in_ms: 40
          move_speed: 1500
          idle_position: 1838
        }
      }
    }
    single_actuation {
      actuator {
        actuator_name: "sts_motor_6"
        id: 6
        actuation_type: STS3215
        comm_type: SERIAL
        serial_config {
          id: 6
          port: "/dev/ttyACM0"
          baudrate: 1000000
        }
        sts3215_config {
          id: 6
          physical_lower_limit: 0
          physical_upper_limit: 4095
          operational_lower_limit: 1762
          operational_upper_limit: 2400
          move_time_in_ms: 40
          move_speed: 2200
          idle_position: 1806
        }
      }
    }
  }

  perceptions {
    single_perception {
      sensor {
        sensor_name: "webcam"
        id: 1
        sensor_type: CAMERA
        comm_type: COMM_INVALID
        camera_config {
          id: 1
        }
      }
    }
    single_perception {
      sensor {
        sensor_name: "sts3215_encoder_1"
        id: 2
        sensor_type: ENCODER
        comm_type: SERIAL
        serial_config {
          id: 1
          port: "/dev/ttyACM0"
          baudrate: 1000000
        }
        sts3215_encoder_config {
          id: 1
        }
      }
    }
    single_perception {
      sensor {
        sensor_name: "sts3215_encoder_2"
