robot {
  name: "so100"
  id: 1
  trigger_frequency: 10
  robot_type: MANIPULATOR_ARM

  actuations {
    single_actuation {
      actuator {
        actuator_name: "sts_motor_1"
        id: 1
        actuation_type: STS3215
        comm_type: SERIAL
        serial_config {
          id: 1
          port: "/dev/ttyACM0"
          baudrate: 1000000
        }
        sts3215_config {
          id: 1
          physical_lower_limit: 0
          physical_upper_limit: 4095
          operational_lower_limit: 1024
          operational_upper_limit: 3072
          move_time_in_ms: 40
          move_speed: 1500
          idle_position: 2070
        }
      }
    }
    single_actuation {
      actuator {
        actuator_name: "sts_motor_2"
        id: 2
        actuation_type: STS3215
        comm_type: SERIAL
        serial_config {
          id: 2
          port: "/dev/ttyACM0"
          baudrate: 1000000
        }
        sts3215_config {
          id: 2
          physical_lower_limit: 0
          physical_upper_limit: 4095
          operational_lower_limit: 800
          operational_upper_limit: 3000
          move_time_in_ms: 40
          move_speed: 1500
          idle_position: 847
        }
      }
