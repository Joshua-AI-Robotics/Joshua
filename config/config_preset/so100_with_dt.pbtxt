        sensor_name: "sts3215_encoder_5"
        id: 5
        sensor_type: ENCODER
        comm_type: SERIAL
        serial_config {
          id: 5
          port: "/dev/ttyACM0"
          baudrate: 1000000
        }
        sts3215_encoder_config {
          id: 5
