# Fully proto-defined bileg task using rsl_rl backend.
# Two-legged robot with lego motors (slow, position-controlled).
# Task: move forward.
#
# Usage:
#   bazel run //ai/train:trainer -- \
#       --config config/config_preset/bileg/bileg_train_isaac_full_rsl_rl.pbtxt

general {
  operation_mode: MODE_TRAINING
  name: "bileg"
}
ai {
  training {
    environment: TRAINING_ENV_SIMULATION
    method: TRAINING_METHOD_RL
    simulator_backend: SIM_BACKEND_ISAAC_SIM
    rl {
      algorithm: "rsl_rl"
      max_iterations: 3000
      num_envs: 4096
      save_path: "bileg_full_ppo"
      render: false
      seed: 42
      save_interval: 50

      task_config {
        task_name: "bileg_full"
        robot {
          usd_filename: "bileg_isaac.usda"
          init_pos_z: 0.25
          init_joint_pos {
            key: ".*_motor"
            value: 0.0
          }
          actuator_damping: 15.0
        }
        rewards {
          key: "progress"
          value {
            weight: 5.0
          }
        }
        rewards {
          key: "alive"
          value {
            weight: 0.0
          }
        }
        rewards {
          key: "upright"
          value {
            weight: 0.3
            params {
              key: "threshold"
              value: 0.93
            }
          }
        }
        rewards {
          key: "move_to_target"
          value {
            weight: 2.0
            params {
              key: "threshold"
              value: 0.8
            }
          }
        }
        rewards {
          key: "lin_vel_z"
          value {
            weight: -0.2
          }
        }
        rewards {
          key: "ang_vel_xy"
          value {
            weight: -0.1
          }
        }
        rewards {
          key: "flat_orientation"
          value {
            weight: -0.2
          }
        }
        rewards {
          key: "action_rate"
          value {
            weight: -0.01
          }
        }
        rewards {
          key: "joint_vel"
          value {
            weight: -0.005
          }
        }
        rewards {
          key: "action_l2"
          value {
            weight: -0.01
          }
        }
        rewards {
          key: "energy"
          value {
            weight: -0.02
            gear_ratios {
              key: ".*"
              value: 1.0
            }
          }
        }
        rewards {
          key: "joint_pos_limits"
          value {
            weight: -0.01
            gear_ratios {
              key: ".*"
              value: 1.0
            }
          }
        }
        observations {
          key: "base_height"
          value {}
        }
        observations {
          key: "base_lin_vel"
          value {}
        }
        observations {
          key: "base_ang_vel"
          value {}
        }
        observations {
          key: "base_yaw_roll"
          value {}
        }
        observations {
          key: "base_angle_to_target"
          value {}
        }
        observations {
          key: "base_up_proj"
          value {}
        }
        observations {
          key: "base_heading_proj"
          value {}
        }
        observations {
          key: "joint_pos_norm"
          value {}
        }
        observations {
          key: "joint_vel_rel"
          value {
            params {
              key: "scale"
              value: 0.2
            }
          }
        }
        observations {
          key: "body_forces"
          value {
            body_names: "left_leg"
            body_names: "right_leg"
            params {
              key: "scale"
              value: 0.1
            }
          }
        }
        observations {
          key: "actions"
          value {}
        }
      }

      ppo {
        learning_rate: 0.0003
        gamma: 0.99
        gae_lambda: 0.95
        clip_epsilon: 0.2
        entropy_coef: 0.03
        num_learning_epochs: 5
        num_minibatches: 4
        num_steps_per_env: 32
        desired_kl: 0.02
        max_grad_norm: 1.0
        schedule: "adaptive"
      }
      network {
        actor_hidden_dims: 128
        actor_hidden_dims: 64
        actor_hidden_dims: 32
        critic_hidden_dims: 128
        critic_hidden_dims: 64
        critic_hidden_dims: 32
        activation: "elu"
        init_noise_std: 1.0
      }
      sim_physics {
        decimation: 2
        episode_length_s: 16.0
        sim_dt: 0.00833
        action_scale: 1.5
        env_spacing: 4.0
        terrain_friction: 1.0
        bounce_threshold_velocity: 0.2
      }
      termination {
        min_root_height: 0.05
      }
      reset {
        joint_pos_range_min: -0.1
        joint_pos_range_max: 0.1
        joint_vel_range_min: -0.05
        joint_vel_range_max: 0.05
      }
    }
  }
}
