# Bileg robot (2-legged LEGO walker) in the Isaac Sim viewer.
#
# Requires Isaac Lab installed on the machine:
#   export ISAAC_LAB_PATH=~/IsaacLab
#   export ISAAC_LAB_PYTHON=~/env_isaaclab/bin/python
#
# Launch:
#   bazel run //launcher:joshua_main -- \
#     --config config/config_preset/bileg/bileg_sim_isaac.pbtxt

general {
  operation_mode: MODE_SIMULATION
  name: "bileg"
}
simulation {
  backend: SIM_BACKEND_ISAAC_SIM
  isaac {
    usd_filename: "bileg/bileg_isaac.usda"
    init_pos_z: 0.25
    init_joint_pos {
      key: ".*_motor"
      value: 0.0
    }
    actuator_damping: 15.0
  }
}
