general {
  operation_mode: MODE_TRAINING
  name: "ant"
}
ai {
  training {
    environment: TRAINING_ENV_SIMULATION
    method: TRAINING_METHOD_EVAL
    model_path: "simulation/models/ant.xml"
    simulator_backend: SIM_BACKEND_MJX
    eval {
      task: "ant"
      checkpoint_path: "ant_mjx_ppo.msgpack"
      num_episodes: 5
      render: true
    }
  }
}
