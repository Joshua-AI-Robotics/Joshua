# Playback a simple joint trajectory on SO-100 via trajectory_publisher + actuator_subscriber.
#
# Launch:
#   bazel run //launcher:joshua_main -- \
#     --config=config/config_preset/so100/trajectory_example.pbtxt
#
# Topics use sensor_msgs/msg/JointState on /<device_id>/joint_state.
# Positions use SI radians with the current driver conversion: ticks * 2*pi/4096.
# This preserves the original servo targets; zero is the raw encoder origin,
# not a calibrated robot-model joint zero. Limits and idle positions remain ticks.
# Position-only commands: SI velocity/effort are unsupported by this driver.
# First all joints move to span midpoint, then poses inside the ±10% band.
# Each message contains one named joint; equal-time waypoints dispatch sequentially.
# The six-second trajectory repeats; shutdown moves to configured idle positions.

general {
  operation_mode: MODE_TEST
  robot_type: ROBOT_TYPE_MANIPULATOR_ARM
  name: "so100"
  id: 1
}

robot {
  boards {
    name: "arm_bus"
    board_type: FEETECH_BUS
    comm {
      comm_type: SERIAL
      transport_type: MESSAGE
      serial_config { port: "/dev/ttyACM0" baudrate: 1000000 }
    }
    channels { index: 1 drive: SERVO_BUS_UART servo_bus { servo_id: 1 } }
    channels { index: 2 drive: SERVO_BUS_UART servo_bus { servo_id: 2 } }
    channels { index: 3 drive: SERVO_BUS_UART servo_bus { servo_id: 3 } }
    channels { index: 4 drive: SERVO_BUS_UART servo_bus { servo_id: 4 } }
    channels { index: 5 drive: SERVO_BUS_UART servo_bus { servo_id: 5 } }
    channels { index: 6 drive: SERVO_BUS_UART servo_bus { servo_id: 6 } }
  }
  actions {
    single_actions {
      node {
        id: 1
        node_type: ACTUATOR_SUBSCRIBER
        qos_setting { depth: 10 }
        subscriptions {
          ros2_data_type: JOINT_STATE
          topic: "sts_motor_1/joint_state"
        }
      }
      action_type: ACTUATOR
      actuator {
        actuator_name: "sts_motor_1"
        id: 1
        motor_type: MOTOR_STS3215
        board_name: "arm_bus"
        channel: 1
        physical_lower_limit: 0
        physical_upper_limit: 4095
        operational_lower_limit: 973
        operational_upper_limit: 3034
        sts3215_config {
          servo_id: 1
          move_speed: 1000
          idle_position: 2070
        }
      }
    }
    single_actions {
      node {
        id: 1
        node_type: ACTUATOR_SUBSCRIBER
        qos_setting { depth: 10 }
        subscriptions {
          ros2_data_type: JOINT_STATE
          topic: "sts_motor_2/joint_state"
        }
      }
      action_type: ACTUATOR
      actuator {
        actuator_name: "sts_motor_2"
        id: 2
        motor_type: MOTOR_STS3215
        board_name: "arm_bus"
        channel: 2
        physical_lower_limit: 0
        physical_upper_limit: 4095
        operational_lower_limit: 858
        operational_upper_limit: 3154
        sts3215_config {
          servo_id: 2
          move_speed: 1000
          idle_position: 847
        }
      }
    }
    single_actions {
      node {
        id: 1
        node_type: ACTUATOR_SUBSCRIBER
        qos_setting { depth: 10 }
        subscriptions {
          ros2_data_type: JOINT_STATE
          topic: "sts_motor_3/joint_state"
        }
      }
      action_type: ACTUATOR
      actuator {
        actuator_name: "sts_motor_3"
        id: 3
        motor_type: MOTOR_STS3215
        board_name: "arm_bus"
        channel: 3
        physical_lower_limit: 0
        physical_upper_limit: 4095
        operational_lower_limit: 798
        operational_upper_limit: 3015
        sts3215_config {
          servo_id: 3
          move_speed: 1000
          idle_position: 3011
        }
      }
    }
    single_actions {
      node {
        id: 1
        node_type: ACTUATOR_SUBSCRIBER
        qos_setting { depth: 10 }
        subscriptions {
          ros2_data_type: JOINT_STATE
          topic: "sts_motor_4/joint_state"
        }
      }
      action_type: ACTUATOR
      actuator {
        actuator_name: "sts_motor_4"
        id: 4
        motor_type: MOTOR_STS3215
        board_name: "arm_bus"
        channel: 4
        physical_lower_limit: 0
        physical_upper_limit: 4095
        operational_lower_limit: 668
        operational_upper_limit: 3124
        sts3215_config {
          servo_id: 4
          move_speed: 1000
          idle_position: 655
        }
      }
    }
    single_actions {
      node {
        id: 1
        node_type: ACTUATOR_SUBSCRIBER
        qos_setting { depth: 10 }
        subscriptions {
          ros2_data_type: JOINT_STATE
          topic: "sts_motor_5/joint_state"
        }
      }
      action_type: ACTUATOR
      actuator {
        actuator_name: "sts_motor_5"
        id: 5
        motor_type: MOTOR_STS3215
        board_name: "arm_bus"
        channel: 5
        physical_lower_limit: 0
        physical_upper_limit: 4095
        operational_lower_limit: 902
        operational_upper_limit: 2955
        sts3215_config {
          servo_id: 5
          move_speed: 1000
          idle_position: 1838
        }
      }
    }
    single_actions {
      node {
        id: 1
        node_type: ACTUATOR_SUBSCRIBER
        qos_setting { depth: 10 }
        subscriptions {
          ros2_data_type: JOINT_STATE
          topic: "sts_motor_6/joint_state"
        }
      }
      action_type: ACTUATOR
      actuator {
        actuator_name: "sts_motor_6"
        id: 6
        motor_type: MOTOR_STS3215
        board_name: "arm_bus"
        channel: 6
        physical_lower_limit: 0
        physical_upper_limit: 4095
        operational_lower_limit: 1795
        operational_upper_limit: 3235
        sts3215_config {
          servo_id: 6
          move_speed: 1000
          idle_position: 1806
        }
      }
    }
  }

  trajectories {
    single_trajectories {
      node {
        id: 2
        node_type: TRAJECTORY_PUBLISHER
        qos_setting { depth: 10 }
        publishers {
          ros2_data_type: JOINT_STATE
          topic: "sts_motor_1/joint_state"
        }
        publishers {
          ros2_data_type: JOINT_STATE
          topic: "sts_motor_2/joint_state"
        }
        publishers {
          ros2_data_type: JOINT_STATE
          topic: "sts_motor_3/joint_state"
        }
        publishers {
          ros2_data_type: JOINT_STATE
          topic: "sts_motor_4/joint_state"
        }
        publishers {
          ros2_data_type: JOINT_STATE
          topic: "sts_motor_5/joint_state"
        }
        publishers {
          ros2_data_type: JOINT_STATE
          topic: "sts_motor_6/joint_state"
        }
      }
      trajectory {
        # Midpoint of each joint's operational span, converted from ticks to radians.
        waypoints { timestamp_sec: 0.0 topic: "sts_motor_1/joint_state" action { joint { joint_name: "sts_motor_1" position_encoding: POSITION_SI units: SI position: 3.0740974989228249 } } }
        waypoints { timestamp_sec: 0.0 topic: "sts_motor_2/joint_state" action { joint { joint_name: "sts_motor_2" position_encoding: POSITION_SI units: SI position: 3.0771654604985961 } } }
        waypoints { timestamp_sec: 0.0 topic: "sts_motor_3/joint_state" action { joint { joint_name: "sts_motor_3" position_encoding: POSITION_SI units: SI position: 2.9253013624979176 } } }
        waypoints { timestamp_sec: 0.0 topic: "sts_motor_4/joint_state" action { joint { joint_name: "sts_motor_4" position_encoding: POSITION_SI units: SI position: 2.9084275738311756 } } }
        waypoints { timestamp_sec: 0.0 topic: "sts_motor_5/joint_state" action { joint { joint_name: "sts_motor_5" position_encoding: POSITION_SI units: SI position: 2.9590489398314017 } } }
        waypoints { timestamp_sec: 0.0 topic: "sts_motor_6/joint_state" action { joint { joint_name: "sts_motor_6" position_encoding: POSITION_SI units: SI position: 3.8579616815323874 } } }

        # Pose A: all joints move together within ±10% band (20% total span).
        waypoints { timestamp_sec: 1.5 topic: "sts_motor_1/joint_state" action { joint { joint_name: "sts_motor_1" position_encoding: POSITION_SI units: SI position: 3.3900975412272669 } } }
        waypoints { timestamp_sec: 1.5 topic: "sts_motor_2/joint_state" action { joint { joint_name: "sts_motor_2" position_encoding: POSITION_SI units: SI position: 2.7243498792848988 } } }
        waypoints { timestamp_sec: 1.5 topic: "sts_motor_3/joint_state" action { joint { joint_name: "sts_motor_3" position_encoding: POSITION_SI units: SI position: 3.2643111166206444 } } }
        waypoints { timestamp_sec: 1.5 topic: "sts_motor_4/joint_state" action { joint { joint_name: "sts_motor_4" position_encoding: POSITION_SI units: SI position: 2.5310683000113081 } } }
        waypoints { timestamp_sec: 1.5 topic: "sts_motor_5/joint_state" action { joint { joint_name: "sts_motor_5" position_encoding: POSITION_SI units: SI position: 3.2735150013479584 } } }
        waypoints { timestamp_sec: 1.5 topic: "sts_motor_6/joint_state" action { joint { joint_name: "sts_motor_6" position_encoding: POSITION_SI units: SI position: 3.6370684480768554 } } }

        # Pose B: simultaneous opposite corners in band.
        waypoints { timestamp_sec: 3.0 topic: "sts_motor_1/joint_state" action { joint { joint_name: "sts_motor_1" position_encoding: POSITION_SI units: SI position: 2.7565634758304971 } } }
        waypoints { timestamp_sec: 3.0 topic: "sts_motor_2/joint_state" action { joint { joint_name: "sts_motor_2" position_encoding: POSITION_SI units: SI position: 3.4299810417122938 } } }
        waypoints { timestamp_sec: 3.0 topic: "sts_motor_3/joint_state" action { joint { joint_name: "sts_motor_3" position_encoding: POSITION_SI units: SI position: 2.5847576275873054 } } }
        waypoints { timestamp_sec: 3.0 topic: "sts_motor_4/joint_state" action { joint { joint_name: "sts_motor_4" position_encoding: POSITION_SI units: SI position: 3.2857868476510435 } } }
        waypoints { timestamp_sec: 3.0 topic: "sts_motor_5/joint_state" action { joint { joint_name: "sts_motor_5" position_encoding: POSITION_SI units: SI position: 2.6430488975269597 } } }
        waypoints { timestamp_sec: 3.0 topic: "sts_motor_6/joint_state" action { joint { joint_name: "sts_motor_6" position_encoding: POSITION_SI units: SI position: 4.0788549149879199 } } }

        # Pose C: mixed offsets, all joints at once.
        waypoints { timestamp_sec: 4.5 topic: "sts_motor_1/joint_state" action { joint { joint_name: "sts_motor_1" position_encoding: POSITION_SI units: SI position: 3.2213596545598464 } } }
        waypoints { timestamp_sec: 4.5 topic: "sts_motor_2/joint_state" action { joint { joint_name: "sts_motor_2" position_encoding: POSITION_SI units: SI position: 2.8378644575884362 } } }
        waypoints { timestamp_sec: 4.5 topic: "sts_motor_3/joint_state" action { joint { joint_name: "sts_motor_3" position_encoding: POSITION_SI units: SI position: 3.1446606151655643 } } }
        waypoints { timestamp_sec: 4.5 topic: "sts_motor_4/joint_state" action { joint { joint_name: "sts_motor_4" position_encoding: POSITION_SI units: SI position: 2.7611654181941541 } } }
        waypoints { timestamp_sec: 4.5 topic: "sts_motor_5/joint_state" action { joint { joint_name: "sts_motor_5" position_encoding: POSITION_SI units: SI position: 3.1906800388021335 } } }
        waypoints { timestamp_sec: 4.5 topic: "sts_motor_6/joint_state" action { joint { joint_name: "sts_motor_6" position_encoding: POSITION_SI units: SI position: 3.7582529303198209 } } }

        # Return to midpoint together.
        waypoints { timestamp_sec: 6.0 topic: "sts_motor_1/joint_state" action { joint { joint_name: "sts_motor_1" position_encoding: POSITION_SI units: SI position: 3.0740974989228249 } } }
        waypoints { timestamp_sec: 6.0 topic: "sts_motor_2/joint_state" action { joint { joint_name: "sts_motor_2" position_encoding: POSITION_SI units: SI position: 3.0771654604985961 } } }
        waypoints { timestamp_sec: 6.0 topic: "sts_motor_3/joint_state" action { joint { joint_name: "sts_motor_3" position_encoding: POSITION_SI units: SI position: 2.9253013624979176 } } }
        waypoints { timestamp_sec: 6.0 topic: "sts_motor_4/joint_state" action { joint { joint_name: "sts_motor_4" position_encoding: POSITION_SI units: SI position: 2.9084275738311756 } } }
        waypoints { timestamp_sec: 6.0 topic: "sts_motor_5/joint_state" action { joint { joint_name: "sts_motor_5" position_encoding: POSITION_SI units: SI position: 2.9590489398314017 } } }
        waypoints { timestamp_sec: 6.0 topic: "sts_motor_6/joint_state" action { joint { joint_name: "sts_motor_6" position_encoding: POSITION_SI units: SI position: 3.8579616815323874 } } }
      }
    }
  }
}
