          ros2_data_type: FLOAT32
          topic: "sts3215_encoder_1"
          publish_rate_hz: 30
        }
      }
      perception_type: ENCODER
      encoder {
        encoder_name: "sts3215_encoder_1"
        id: 1
        encoder_type: STS3215_ENCODER
        comm {
          comm_type: SERIAL
          serial_config {
            id: 1
            port: "/dev/ttyACM1"
            baudrate: 1000000
          }
        }
        operational_lower_limit: 973
        operational_upper_limit: 3034
        sts3215_encoder_config {
          servo_id: 1
