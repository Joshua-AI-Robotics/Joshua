general{
  operation_mode: MODE_CALIBRATION
  robot_type: ROBOT_TYPE_MANIPULATOR_ARM
  name: "so100"
  id: 1
}
robot {
  perceptions {
    single_perceptions {
      node {
        id: 1
        node_type: ENCODER_PUBLISHER
        qos_setting {}
