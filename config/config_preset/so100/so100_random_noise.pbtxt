ai {
  models {
    single_models {
      model_type: RANDOM_NOISE
      node {
        id: 3
        node_type: INFERENCE
        qos_setting {}
        subscriptions {
          ros2_data_type: IMAGE
          topic: "camera_1"
        }
        publishers {
          ros2_data_type: UINT8_MULTI_ARRAY
          topic: "mock_action_1"
          payload_type: PAYLOAD_TYPE_ACTION_PACKET
        }
        publishers {
          ros2_data_type: UINT8_MULTI_ARRAY
          topic: "mock_action_2"
          payload_type: PAYLOAD_TYPE_ACTION_PACKET
        }
        publishers {
          ros2_data_type: UINT8_MULTI_ARRAY
          topic: "mock_action_3"
          payload_type: PAYLOAD_TYPE_ACTION_PACKET
        }
        publishers {
