    single_perceptions {
      node {
        id: 2
        node_type: CAMERA_PUBLISHER
        qos_setting {}
        publishers {
          ros2_data_type: IMAGE
          topic: "camera_1"
          publish_rate_hz: 30
        }
      }
      perception_type: CAMERA
      camera {
        camera_name: "webcam"
        id: 1
        camera_type: OPENCV
        comm{}
        opencv_config {
          id: 0
          width: 640
          height: 480
          fps: 30
        }
      }
