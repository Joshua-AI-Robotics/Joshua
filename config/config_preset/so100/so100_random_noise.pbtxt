          payload_type: PAYLOAD_TYPE_ACTION_PACKET
        }
        publishers {
          ros2_data_type: UINT8_MULTI_ARRAY
          topic: "mock_action_5"
          payload_type: PAYLOAD_TYPE_ACTION_PACKET
        }
        publishers {
          ros2_data_type: UINT8_MULTI_ARRAY
          topic: "mock_action_6"
          payload_type: PAYLOAD_TYPE_ACTION_PACKET
        }
      }

      random_noise_config {
        input_size: 1 # TODO: Try with camera image size.
        output_size: 6
        # Operational midpoint ± 10% of each joint's operational span.
        output_ranges { low: 1797 high: 2210 }
        output_ranges { low: 1776 high: 2236 }
        output_ranges { low: 1685 high: 2128 }
        output_ranges { low: 1650 high: 2142 }
        output_ranges { low: 1723 high: 2134 }
        output_ranges { low: 2371 high: 2659 }
      }
    }
  }
}
