general{
  operation_mode: MODE_INFERENCE
  robot_type: ROBOT_TYPE_MANIPULATOR_ARM
  name: "so100"
  id: 1
}
robot {
  actions {
    single_actions {
      node {
        id: 1
        node_type: ACTUATOR_SUBSCRIBER
        qos_setting {}
        subscriptions {
          ros2_data_type: UINT8_MULTI_ARRAY
          topic: "mock_action_1"
          payload_type: PAYLOAD_TYPE_ACTION_PACKET
        }
      }
      action_type: ACTUATOR
      actuator {
        actuator_name: "sts_motor_1"
        id: 1
        actuator_type: STS3215_SERVO
        comm {
          comm_type: SERIAL
          serial_config {
            id: 1
            port: "/dev/ttyACM0"
            baudrate: 1000000
          }
        }
        physical_lower_limit: 0
        physical_upper_limit: 4095
        operational_lower_limit: 973
        operational_upper_limit: 3034
        encoder_data_mode: ENCODER_DATA_MODE_RAW
        sts3215_config {
          servo_id: 1
          move_time_in_ms: 40
          move_speed: 500
          idle_position: 2070
        }
      }
    }
    single_actions {
