general{
  operation_mode: MODE_INFERENCE
}

robot {
  name: "so100"
  id: 1
  robot_type: MANIPULATOR_ARM

  actions {
    single_actions {
      node_id: 1
      subscribe_topic: "smolvla_action_1"
      action_type: ACTUATOR
      actuator {
        actuator_name: "sts_motor_1"
        id: 1
        actuator_type: STS3215_SERVO
        comm {
          comm_type: SERIAL
          serial_config {
            id: 1
            port: "/dev/ttyACM0"
            baudrate: 1000000
          }
        }
        physical_lower_limit: 0
        physical_upper_limit: 4095
        operational_lower_limit: 973
        operational_upper_limit: 3034
        encoder_data_mode: ENCODER_DATA_MODE_NORMALIZED_MINUS_ONE_TO_ONE
        sts3215_config {
          servo_id: 1
          move_time_in_ms: 40
          move_speed: 1500
          idle_position: 2070
        }
      }
    }
    single_actions {
      node_id: 1
      subscribe_topic: "smolvla_action_2"
      action_type: ACTUATOR
      actuator {
        actuator_name: "sts_motor_2"
        id: 2
        actuator_type: STS3215_SERVO
        comm {
          comm_type: SERIAL
          serial_config {
            id: 2
            port: "/dev/ttyACM0"
            baudrate: 1000000
          }
        }
        physical_lower_limit: 0
        physical_upper_limit: 4095
        operational_lower_limit: 858
        operational_upper_limit: 3154
        encoder_data_mode: ENCODER_DATA_MODE_NORMALIZED_MINUS_ONE_TO_ONE
        sts3215_config {
          servo_id: 2
          move_time_in_ms: 40
          move_speed: 1500
          idle_position: 847
        }
      }
    }
    single_actions {
      node_id: 1
      subscribe_topic: "smolvla_action_3"
      action_type: ACTUATOR
      actuator {
        actuator_name: "sts_motor_3"
        id: 3
        actuator_type: STS3215_SERVO
        comm {
          comm_type: SERIAL
          serial_config {
            id: 3
            port: "/dev/ttyACM0"
            baudrate: 1000000
          }
        }
        physical_lower_limit: 0
         physical_upper_limit: 4095
        operational_lower_limit: 798
        operational_upper_limit: 3015
        encoder_data_mode: ENCODER_DATA_MODE_NORMALIZED_MINUS_ONE_TO_ONE
        sts3215_config {
          servo_id: 3
          move_time_in_ms: 40
          move_speed: 1500
          idle_position: 3011
        }
      }
    }
    single_actions {
      node_id: 1
      subscribe_topic: "smolvla_action_4"
      action_type: ACTUATOR
      actuator {
        actuator_name: "sts_motor_4"
        id: 4
        actuator_type: STS3215_SERVO
        comm {
          comm_type: SERIAL
          serial_config {
            id: 4
            port: "/dev/ttyACM0"
            baudrate: 1000000
          }
        }
        physical_lower_limit: 0
        physical_upper_limit: 4095
        operational_lower_limit: 668
        operational_upper_limit: 3124
        encoder_data_mode: ENCODER_DATA_MODE_NORMALIZED_MINUS_ONE_TO_ONE
        sts3215_config {
          servo_id: 4
          move_time_in_ms: 40
          move_speed: 1500
          idle_position: 655
        }
      }
    }
    single_actions {
      node_id: 1
      subscribe_topic: "smolvla_action_5"
      action_type: ACTUATOR
      actuator {
        actuator_name: "sts_motor_5"
        id: 5
        actuator_type: STS3215_SERVO
        comm {
          comm_type: SERIAL
          serial_config {
            id: 5
            port: "/dev/ttyACM0"
            baudrate: 1000000
          }
        }
        physical_lower_limit: 0
        physical_upper_limit: 4095
        operational_lower_limit: 902
        operational_upper_limit: 2955
        encoder_data_mode: ENCODER_DATA_MODE_NORMALIZED_MINUS_ONE_TO_ONE
        sts3215_config {
          servo_id: 5
          move_time_in_ms: 40
          move_speed: 1500
          idle_position: 1838
        }
      }
    }
    single_actions {
      node_id: 1
      subscribe_topic: "smolvla_action_6"
      action_type: ACTUATOR
      actuator {
        actuator_name: "sts_motor_6"
        id: 6
        actuator_type: STS3215_SERVO
        comm {
          comm_type: SERIAL
          serial_config {
            id: 6
            port: "/dev/ttyACM0"
            baudrate: 1000000
          }
        }
        physical_lower_limit: 0
        physical_upper_limit: 4095
        operational_lower_limit: 1795
        operational_upper_limit: 3235
        encoder_data_mode: ENCODER_DATA_MODE_NORMALIZED_MINUS_ONE_TO_ONE
        sts3215_config {
          servo_id: 6
          move_time_in_ms: 40
          move_speed: 2200
          idle_position: 1806
        }
      }
    }
  }

  perceptions {
    single_perceptions {
      node_id: 2
      publish_topic: "camera_1"
      perception_type: CAMERA
      publish_rate_hz: 30
      camera {
        camera_name: "webcam"
        id: 0
        camera_type: OPENCV
        comm{}
        opencv_config {
          id: 0  # Using /dev/video0
          width: 640
          height: 480
          fps: 30
        }
      }
    }
    
    # Encoder publishers for joint state feedback (read from follower arm motors)
    single_perceptions {
      node_id: 4
      publish_topic: "encoder_1"
      perception_type: ENCODER
      publish_rate_hz: 30
      encoder {
        encoder_name: "sts3215_encoder_1"
        id: 1
        encoder_type: STS3215_ENCODER
        comm {
          comm_type: SERIAL
          serial_config {
            id: 1
            port: "/dev/ttyACM0"
            baudrate: 1000000
          }
        }
        operational_lower_limit: 973
        operational_upper_limit: 3034
        encoder_data_mode: ENCODER_DATA_MODE_NORMALIZED_MINUS_ONE_TO_ONE
        sts3215_encoder_config {
          servo_id: 1
        }
      }
    }
    single_perceptions {
      node_id: 4
      publish_topic: "encoder_2"
      perception_type: ENCODER
      publish_rate_hz: 30
      encoder {
        encoder_name: "sts3215_encoder_2"
        id: 2
        encoder_type: STS3215_ENCODER
        comm {
          comm_type: SERIAL
          serial_config {
            id: 2
            port: "/dev/ttyACM0"
            baudrate: 1000000
          }
        }
        operational_lower_limit: 858
        operational_upper_limit: 3154
        encoder_data_mode: ENCODER_DATA_MODE_NORMALIZED_MINUS_ONE_TO_ONE
        sts3215_encoder_config {
          servo_id: 2
        }
      }
    }
    single_perceptions {
      node_id: 4
      publish_topic: "encoder_3"
      perception_type: ENCODER
      publish_rate_hz: 30
      encoder {
        encoder_name: "sts3215_encoder_3"
        id: 3
        encoder_type: STS3215_ENCODER
        comm {
          comm_type: SERIAL
          serial_config {
            id: 3
            port: "/dev/ttyACM0"
            baudrate: 1000000
          }
        }
        operational_lower_limit: 798
        operational_upper_limit: 3015
        encoder_data_mode: ENCODER_DATA_MODE_NORMALIZED_MINUS_ONE_TO_ONE
        sts3215_encoder_config {
          servo_id: 3
        }
      }
    }
    single_perceptions {
      node_id: 4
      publish_topic: "encoder_4"
      perception_type: ENCODER
      publish_rate_hz: 30
      encoder {
        encoder_name: "sts3215_encoder_4"
        id: 4
        encoder_type: STS3215_ENCODER
        comm {
          comm_type: SERIAL
          serial_config {
            id: 4
            port: "/dev/ttyACM0"
            baudrate: 1000000
          }
        }
        operational_lower_limit: 668
        operational_upper_limit: 3124
        encoder_data_mode: ENCODER_DATA_MODE_NORMALIZED_MINUS_ONE_TO_ONE
        sts3215_encoder_config {
          servo_id: 4
        }
      }
    }
    single_perceptions {
      node_id: 4
      publish_topic: "encoder_5"
      perception_type: ENCODER
      publish_rate_hz: 30
      encoder {
        encoder_name: "sts3215_encoder_5"
        id: 5
        encoder_type: STS3215_ENCODER
        comm {
          comm_type: SERIAL
          serial_config {
            id: 5
            port: "/dev/ttyACM0"
            baudrate: 1000000
          }
        }
        operational_lower_limit: 902
        operational_upper_limit: 2955
        encoder_data_mode: ENCODER_DATA_MODE_NORMALIZED_MINUS_ONE_TO_ONE
        sts3215_encoder_config {
          servo_id: 5
        }
      }
    }
    single_perceptions {
      node_id: 4
      publish_topic: "encoder_6"
      perception_type: ENCODER
      publish_rate_hz: 30
      encoder {
        encoder_name: "sts3215_encoder_6"
        id: 6
        encoder_type: STS3215_ENCODER
        comm {
          comm_type: SERIAL
          serial_config {
            id: 6
            port: "/dev/ttyACM0"
            baudrate: 1000000
          }
        }
        operational_lower_limit: 1795
        operational_upper_limit: 3235
        encoder_data_mode: ENCODER_DATA_MODE_NORMALIZED_MINUS_ONE_TO_ONE
        sts3215_encoder_config {
          servo_id: 6
        }
      }
    }
  }
}

ai {
  models {
    single_model {
      policy_name: "smolvla_policy"
      pretrained_model_path: "lerobot/smolvla_base"
      node_id: 3

      subscriptions {
        ros2_data_type: IMAGE
        topic: "camera_1"
      }
      
      # Subscribe to encoder joint states for proprioceptive feedback
      subscriptions {
        ros2_data_type: FLOAT32
        topic: "encoder_1"
      }
      subscriptions {
        ros2_data_type: FLOAT32
        topic: "encoder_2"
      }
      subscriptions {
        ros2_data_type: FLOAT32
        topic: "encoder_3"
      }
      subscriptions {
        ros2_data_type: FLOAT32
        topic: "encoder_4"
      }
      subscriptions {
        ros2_data_type: FLOAT32
        topic: "encoder_5"
      }
      subscriptions {
        ros2_data_type: FLOAT32
        topic: "encoder_6"
      }

      pubishers {
        ros2_data_type: FLOAT32
        topic: "smolvla_action_1"
      }
      pubishers {
        ros2_data_type: FLOAT32
        topic: "smolvla_action_2"
      }
      pubishers {
        ros2_data_type: FLOAT32
        topic: "smolvla_action_3"
      }
      pubishers {
        ros2_data_type: FLOAT32
        topic: "smolvla_action_4"
      }
      pubishers {
        ros2_data_type: FLOAT32
        topic: "smolvla_action_5"
      }
      pubishers {
        ros2_data_type: FLOAT32
        topic: "smolvla_action_6"
      }
    }
  }
}

