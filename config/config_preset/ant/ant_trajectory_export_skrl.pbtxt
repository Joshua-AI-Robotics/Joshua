# Export a trained ant policy (skrl) as a constant trajectory.
#
# Loads a skrl checkpoint, runs it in Isaac Sim, records joint
# positions and torques, and writes deployable .pbtxt trajectory
# files plus .npy for MuJoCo verification.
#
# Workflow:
#   1. Train:  bazel run //ai/train:trainer -- \
#        --config config/config_preset/ant/ant_train_isaac_full_skrl.pbtxt
#   2. Export: bazel run //ai/train:trainer -- \
#        --config config/config_preset/ant/ant_trajectory_export_skrl.pbtxt
#   3. Output files appear in /tmp/joshua_checkpoints/trajectory_export/
#      - trajectory_position.pbtxt  (joint position waypoints)
#      - trajectory_torque.pbtxt    (raw policy action waypoints)
#      - trajectory_position.npy    (for MuJoCo passive playback)
#      - trajectory_torque.npy
#      - trajectory_meta.json

general {
  operation_mode: MODE_TRAINING
  name: "ant"
}
ai {
  training {
    environment: TRAINING_ENV_SIMULATION
    method: TRAINING_METHOD_TRAJECTORY_EXPORT
    simulator_backend: SIM_BACKEND_ISAAC_SIM
    trajectory_export {
      algorithm: "skrl"
      checkpoint_path: "/tmp/joshua_checkpoints/isaac_logs/ant_full_skrl_ppo/final_policy.pt"
      warmup_steps: 200
      num_record_steps: 1000
      detect_cycle: true
      trajectory_node_id: 1
      render: false

      # Map Isaac Lab joint names to ROS2 actuator command topics.
      # Update these topics to match your real robot's actuator config.
      joint_topic_mappings { joint_name: "front_left_leg"     topic: "ant/front_left_leg/command" }
      joint_topic_mappings { joint_name: "front_left_foot"    topic: "ant/front_left_foot/command" }
      joint_topic_mappings { joint_name: "front_right_leg"    topic: "ant/front_right_leg/command" }
      joint_topic_mappings { joint_name: "front_right_foot"   topic: "ant/front_right_foot/command" }
      joint_topic_mappings { joint_name: "left_back_leg"      topic: "ant/left_back_leg/command" }
      joint_topic_mappings { joint_name: "left_back_foot"     topic: "ant/left_back_foot/command" }
      joint_topic_mappings { joint_name: "right_back_leg"     topic: "ant/right_back_leg/command" }
      joint_topic_mappings { joint_name: "right_back_foot"    topic: "ant/right_back_foot/command" }

      # Must match the skrl training config exactly to rebuild the env.
      task_config {
        task_name: "ant_full_skrl"
        robot {
          usd_filename: "ant_isaac.usda"
          init_pos_z: 0.5
          init_joint_pos {
            key: ".*_leg"
            value: 0.0
          }
          init_joint_pos {
            key: "front_left_foot"
            value: 0.785398
          }
          init_joint_pos {
            key: "front_right_foot"
            value: -0.785398
          }
          init_joint_pos {
            key: "left_back_foot"
            value: -0.785398
          }
          init_joint_pos {
            key: "right_back_foot"
            value: 0.785398
          }
        }
        rewards {
          key: "progress"
          value {
            weight: 1.0
          }
        }
        rewards {
          key: "alive"
          value {
            weight: 0.5
          }
        }
        rewards {
          key: "upright"
          value {
            weight: 0.1
            params {
              key: "threshold"
              value: 0.93
            }
          }
        }
        rewards {
          key: "move_to_target"
          value {
            weight: 0.5
            params {
              key: "threshold"
              value: 0.8
            }
          }
        }
        rewards {
          key: "action_l2"
          value {
            weight: -0.005
          }
        }
        rewards {
          key: "energy"
          value {
            weight: -0.05
          }
        }
        rewards {
          key: "joint_pos_limits"
          value {
            weight: -0.1
          }
        }
        observations {
          key: "base_height"
          value {}
        }
        observations {
          key: "base_lin_vel"
          value {}
        }
        observations {
          key: "base_ang_vel"
          value {}
        }
        observations {
          key: "base_yaw_roll"
          value {}
        }
        observations {
          key: "base_angle_to_target"
          value {}
        }
        observations {
          key: "base_up_proj"
          value {}
        }
        observations {
          key: "base_heading_proj"
          value {}
        }
        observations {
          key: "joint_pos_norm"
          value {}
        }
        observations {
          key: "joint_vel_rel"
          value {
            params {
              key: "scale"
              value: 0.2
            }
          }
        }
        observations {
          key: "body_forces"
          value {
            body_names: "front_left_foot"
            body_names: "front_right_foot"
            body_names: "left_back_foot"
            body_names: "right_back_foot"
            params {
              key: "scale"
              value: 0.1
            }
          }
        }
        observations {
          key: "actions"
          value {}
        }
      }

      network {
        actor_hidden_dims: 400
        actor_hidden_dims: 200
        actor_hidden_dims: 100
        critic_hidden_dims: 400
        critic_hidden_dims: 200
        critic_hidden_dims: 100
        activation: "elu"
        init_noise_std: 1.0
      }
      sim_physics {
        decimation: 2
        episode_length_s: 16.0
        sim_dt: 0.00833
        action_scale: 7.5
        env_spacing: 5.0
        terrain_friction: 1.0
        bounce_threshold_velocity: 0.2
      }
      termination {
        min_root_height: 0.31
      }
      reset {
        joint_pos_range_min: -0.2
        joint_pos_range_max: 0.2
        joint_vel_range_min: -0.1
        joint_vel_range_max: 0.1
      }
    }
  }
}
