# Ant robot in the Isaac Sim viewer (no training, simulation only).
#
# Requires Isaac Lab installed on the machine:
#   export ISAAC_LAB_PATH=~/IsaacLab
#   export ISAAC_LAB_PYTHON=~/env_isaaclab/bin/python
#
# Launch:
#   bazel run //launcher:joshua_main -- \
#     --config config/config_preset/ant/ant_sim_isaac.pbtxt

general {
  operation_mode: MODE_SIMULATION
  name: "ant"
}
simulation {
  backend: SIM_BACKEND_ISAAC_SIM
  isaac {
    usd_filename: "ant/ant_isaac.usda"
    init_pos_z: 0.5
    init_joint_pos {
      key: ".*_leg"
      value: 0.0
    }
    init_joint_pos {
      key: "front_left_foot"
      value: 0.785398
    }
    init_joint_pos {
      key: "front_right_foot"
      value: -0.785398
    }
    init_joint_pos {
      key: "left_back_foot"
      value: -0.785398
    }
    init_joint_pos {
      key: "right_back_foot"
      value: 0.785398
    }
  }
}
