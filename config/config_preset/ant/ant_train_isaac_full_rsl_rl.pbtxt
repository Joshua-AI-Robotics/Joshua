# Fully proto-defined ant task -- demonstrates zero-Python workflow.
# This preset defines the ant entirely via task_config; no ant.py needed.

general {
  operation_mode: MODE_TRAINING
  name: "ant"
}
ai {
  training {
    environment: TRAINING_ENV_SIMULATION
    method: TRAINING_METHOD_RL
    simulator_backend: SIM_BACKEND_ISAAC_SIM
    rl {
      algorithm: "rsl_rl"
      max_iterations: 1000
      num_envs: 4096
      save_path: "ant_full_ppo"
      render: false
      seed: 42
      save_interval: 50

      task_config {
        task_name: "ant_full"
        robot {
          usd_filename: "ant_isaac.usda"
          init_pos_z: 0.5
          init_joint_pos {
            key: ".*_leg"
            value: 0.0
          }
          init_joint_pos {
            key: "front_left_foot"
            value: 0.785398
          }
          init_joint_pos {
            key: "front_right_foot"
            value: -0.785398
          }
          init_joint_pos {
            key: "left_back_foot"
            value: -0.785398
          }
          init_joint_pos {
            key: "right_back_foot"
            value: 0.785398
          }
        }
        rewards {
          key: "progress"
          value {
            weight: 1.0
          }
        }
        rewards {
          key: "alive"
          value {
            weight: 0.5
          }
        }
        rewards {
          key: "upright"
          value {
            weight: 0.1
            params {
              key: "threshold"
              value: 0.93
            }
          }
        }
        rewards {
          key: "move_to_target"
          value {
            weight: 0.5
            params {
              key: "threshold"
              value: 0.8
            }
          }
        }
        rewards {
          key: "action_l2"
          value {
            weight: -0.005
          }
        }
        rewards {
          key: "energy"
          value {
            weight: -0.05
          }
        }
        rewards {
          key: "joint_pos_limits"
          value {
            weight: -0.1
          }
        }
        observations {
          key: "base_height"
          value {}
        }
        observations {
          key: "base_lin_vel"
          value {}
        }
        observations {
          key: "base_ang_vel"
          value {}
        }
        observations {
          key: "base_yaw_roll"
          value {}
        }
        observations {
          key: "base_angle_to_target"
          value {}
        }
        observations {
          key: "base_up_proj"
          value {}
        }
        observations {
          key: "base_heading_proj"
          value {}
        }
        observations {
          key: "joint_pos_norm"
          value {}
        }
        observations {
          key: "joint_vel_rel"
          value {
            params {
              key: "scale"
              value: 0.2
            }
          }
        }
        observations {
          key: "body_forces"
          value {
            body_names: "front_left_foot"
            body_names: "front_right_foot"
            body_names: "left_back_foot"
            body_names: "right_back_foot"
            params {
              key: "scale"
              value: 0.1
            }
          }
        }
        observations {
          key: "actions"
          value {}
        }
      }

      ppo {
        learning_rate: 0.0005
        gamma: 0.99
        gae_lambda: 0.95
        clip_epsilon: 0.2
        entropy_coef: 0.0
        num_learning_epochs: 5
        num_minibatches: 4
        num_steps_per_env: 32
      }
      network {
        actor_hidden_dims: 400
        actor_hidden_dims: 200
        actor_hidden_dims: 100
        critic_hidden_dims: 400
        critic_hidden_dims: 200
        critic_hidden_dims: 100
        activation: "elu"
      }
      sim_physics {
        decimation: 2
        episode_length_s: 16.0
        sim_dt: 0.00833
        action_scale: 7.5
        env_spacing: 5.0
        terrain_friction: 1.0
      }
      termination {
        min_root_height: 0.31
      }
      reset {
        joint_pos_range_min: -0.2
        joint_pos_range_max: 0.2
        joint_vel_range_min: -0.1
        joint_vel_range_max: 0.1
      }
    }
  }
}
