general {
  operation_mode: MODE_TRAINING
  robot_type: ROBOT_TYPE_MANIPULATOR_ARM
  name: "so100"
}
ai {
  training {
    environment: TRAINING_ENV_SIMULATION
    method: TRAINING_METHOD_EVAL
    eval {
      task: "pick_place"
      checkpoint_path: "pick_place_mjx_ppo.msgpack"
      num_episodes: 10
      render: true
    }
  }
}
