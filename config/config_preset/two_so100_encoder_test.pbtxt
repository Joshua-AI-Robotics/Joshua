operation_mode: MODE_TELEOPERATE

robot {
  name: "so100"
  id: 1
  trigger_frequency: 10
  robot_type: MANIPULATOR_ARM

  perceptions {
    single_perception {
      sensor {
        sensor_name: "sts3215_encoder_1"
        id: 1
        sensor_type: ENCODER
        comm_type: SERIAL
        serial_config {
          id: 1
          port: "/dev/ttyACM1"
          baudrate: 1000000
        }
        encoder_config {
          id: 1
          operational_lower_limit: 952
          operational_upper_limit: 3200
        }
      }
    }
