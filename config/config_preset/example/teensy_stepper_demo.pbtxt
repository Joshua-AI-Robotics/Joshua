# Single NEMA17 stepper on a Teensy 4.1 (TB6600 drive) via joshua_wire_v1
# over native USB serial (docs/BOARD_LAYER_RFC.md §10 Phase 5). See
# firmware/teensy/41/docs/bringup.md for wiring, flashing, and
# verification steps before running this against real hardware.
#
# Launch:
#   bazel run //launcher:joshua_main -- \
#     --config=config/config_preset/example/teensy_stepper_demo.pbtxt
#
# Topic uses Float32 on /teensy_stepper_1/position, in degrees (this
# preset's stepper_config converts to native steps before it reaches the
# wire).

general {
  operation_mode: MODE_TEST
  robot_type: ROBOT_TYPE_MANIPULATOR_ARM
  name: "teensy_stepper_demo"
  id: 41
}

robot {
  boards {
    name: "stepper_bus"
    board_type: TEENSY41
    comm {
      comm_type: SERIAL
      serial_config { port: "/dev/ttyACM0" baudrate: 115200 }
    }
    firmware {
      name: "teensy-stepdir"
      min_proto_version: 1
    }
    channels {
      index: 0
      drive: STEP_DIR
      step_dir {
        max_pulse_rate_hz: 4000
        invert_dir: false
        enable_active_low: true
      }
    }
  }
  actions {
    single_actions {
      node {
        id: 1
        node_type: ACTUATOR_SUBSCRIBER
        qos_setting { depth: 10 }
        subscriptions {
          ros2_data_type: FLOAT32
          topic: "teensy_stepper_1/position"
          normalized: false
        }
      }
      action_type: ACTUATOR
      actuator {
        actuator_name: "teensy_stepper_1"
        id: 1
        motor_type: MOTOR_STEPPER_NEMA17
        board_name: "stepper_bus"
        channel: 0
        physical_lower_limit: -180
        physical_upper_limit: 180
        operational_lower_limit: -90
        operational_upper_limit: 90
        stepper_config {
          # 1.8-degree/step NEMA17 at 1/16 microstepping: 200 * 16 / 360.
          steps_per_degree: 8.888889
          gear_ratio: 1.0
          idle_position: 0
        }
      }
    }
  }
}
