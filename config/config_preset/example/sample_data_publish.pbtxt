general{
  operation_mode: MODE_TEST
  robot_type: ROBOT_TYPE_MANIPULATOR_ARM
  name: "sample_data_publish"
  id: 2
}

robot {
  boards {
    name: "encoder_bus"
    board_type: FEETECH_BUS
    comm {
      comm_type: SERIAL
      transport_type: MESSAGE
      serial_config { port: "/dev/ttyACM1" baudrate: 1000000 }
    }
    channels { index: 1 drive: SERVO_BUS_UART servo_bus { servo_id: 1 } }
    channels { index: 2 drive: SERVO_BUS_UART servo_bus { servo_id: 2 } }
    channels { index: 3 drive: SERVO_BUS_UART servo_bus { servo_id: 3 } }
    channels { index: 4 drive: SERVO_BUS_UART servo_bus { servo_id: 4 } }
    channels { index: 5 drive: SERVO_BUS_UART servo_bus { servo_id: 5 } }
    channels { index: 6 drive: SERVO_BUS_UART servo_bus { servo_id: 6 } }
  }

  perceptions {
    single_perceptions {
      node {
        id: 2
        node_type: CAMERA_PUBLISHER
        qos_setting {}
        publishers {
          ros2_data_type: IMAGE
          topic: "camera_1"
          publish_rate_hz: 30
        }
      }
      sensor_name: "webcam"
      id: 1
      sensor_type: IMAGE
      opencv_config {
        id: 0
        width: 640
        height: 480
        fps: 30
      }
    }
    single_perceptions {
      node {
        id: 1
        node_type: POSITION_PUBLISHER
        qos_setting {}
        publishers {
          ros2_data_type: FLOAT32
          topic: "sts3215_encoder_1"
          publish_rate_hz: 30
        }
      }
      sensor_name: "sts3215_encoder_1"
      id: 1
      sensor_type: POSITION
      sts3215_encoder_config {
        board_name: "encoder_bus"
        channel: 1
      }
    }
    single_perceptions {
      node {
        id: 1
        node_type: POSITION_PUBLISHER
        qos_setting {}
        publishers {
          ros2_data_type: FLOAT32
          topic: "sts3215_encoder_2"
          publish_rate_hz: 30
        }
      }
      sensor_name: "sts3215_encoder_2"
      id: 2
      sensor_type: POSITION
      sts3215_encoder_config {
        board_name: "encoder_bus"
        channel: 2
      }
    }
    single_perceptions {
      node {
        id: 1
        node_type: POSITION_PUBLISHER
        qos_setting {}
        publishers {
          ros2_data_type: FLOAT32
          topic: "sts3215_encoder_3"
          publish_rate_hz: 30
        }
      }
      sensor_name: "sts3215_encoder_3"
      id: 3
      sensor_type: POSITION
      sts3215_encoder_config {
        board_name: "encoder_bus"
        channel: 3
      }
    }
    single_perceptions {
      node {
        id: 1
        node_type: POSITION_PUBLISHER
        qos_setting {}
        publishers {
          ros2_data_type: FLOAT32
          topic: "sts3215_encoder_4"
          publish_rate_hz: 30
        }
      }
      sensor_name: "sts3215_encoder_4"
      id: 4
      sensor_type: POSITION
      sts3215_encoder_config {
        board_name: "encoder_bus"
        channel: 4
      }
    }
    single_perceptions {
      node {
        id: 1
        node_type: POSITION_PUBLISHER
        qos_setting {}
        publishers {
          ros2_data_type: FLOAT32
          topic: "sts3215_encoder_5"
          publish_rate_hz: 30
        }
      }
      sensor_name: "sts3215_encoder_5"
      id: 5
      sensor_type: POSITION
      sts3215_encoder_config {
        board_name: "encoder_bus"
        channel: 5
      }
    }
    single_perceptions {
      node {
        id: 1
        node_type: POSITION_PUBLISHER
        qos_setting {}
        publishers {
          ros2_data_type: FLOAT32
          topic: "sts3215_encoder_6"
          publish_rate_hz: 30
        }
      }
      sensor_name: "sts3215_encoder_6"
      id: 6
      sensor_type: POSITION
      sts3215_encoder_config {
        board_name: "encoder_bus"
        channel: 6
      }
    }
  }
}
