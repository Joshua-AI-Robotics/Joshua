general {
  operation_mode: MODE_TEST
  robot_type: ROBOT_TYPE_MANIPULATOR_ARM
  name: "am243_ethercat_demo"
  id: 243
}

robot {
  # Board-layer shape (docs/BOARD_LAYER_RFC.md §6.5): the AM243 is one
  # EtherCAT slave under the NIC's shared SOEM master; the actuator binds
  # via (board_name, channel). PDO offsets/sizes are omitted so the board
  # resolves the region from slave discovery; set them to pin a region.
  boards {
    name: "am243_1"
    board_type: AM243
    comm {
      comm_type: ETHERCAT
      ethercat_config {
        interface_name: "ethercat0"
        process_data_mode: ETHERCAT_PROCESS_DATA_MODE_SPLIT_LRD_LWR
      }
    }
    channels { index: 0 drive: PDO_JOINT }
    am243_config {
      slave_index: 1
      pdo_mapping: AM243_PDO_MAPPING_TI_DEMO
    }
  }
  actions {
    single_actions {
      node {
        id: 1
        node_type: ACTUATOR_SUBSCRIBER
        qos_setting { depth: 10 }
        subscriptions {
          ros2_data_type: FLOAT32
          topic: "am243_joint_1/position"
          normalized: false
        }
      }
      action_type: ACTUATOR
      actuator {
        actuator_name: "am243_joint_1"
        id: 1
        # Board-layer AM243: actuator_type unset -> ActionFactory ->
        # Am243Board -> TiDemoDriver (docs/BOARD_LAYER_RFC.md §10 Phase 3).
        motor_type: MOTOR_TI_DEMO
        board_name: "am243_1"
        channel: 0
        physical_lower_limit: -180
        physical_upper_limit: 180
        operational_lower_limit: -90
        operational_upper_limit: 90
        # Bridge until idle_position moves to a motor-level config (Phase 4).
        am243_ethercat_config {
          idle_position: 0
        }
      }
    }
  }
}
