# Arduino Uno R3 over USB-serial (joshua_wire_v1). First hardware goal is
# IDENTIFY-only: USB cable, no TB6600/motor. Init() must succeed (handshake
# + CONFIGURE_CHANNEL). Motion wiring is documented in
# firmware/arduino/uno/README.md but is not required for this pass.
#
# Official Uno R3 typically enumerates as /dev/ttyACM0; CH340 clones as
# /dev/ttyUSB0. ArduinoBoard::Init waits ~2s after open for DTR auto-reset.
#
# Identify-only (preferred first):
#   bazel run //robot/board/arduino:arduino_driver_smoke -- /dev/ttyACM0
#
# Full launcher (also runs IDENTIFY at actuator Init; do not topic-pub
# positions until a drive is wired):
#   bazel run //launcher:joshua_main -- \
#     --config=config/config_preset/example/arduino_stepper_demo.pbtxt

general {
  operation_mode: MODE_TEST
  robot_type: ROBOT_TYPE_MANIPULATOR_ARM
  name: "arduino_stepper_demo"
  id: 328
}

robot {
  boards {
    name: "stepper_bus"
    board_type: ARDUINO_UNO
    comm {
      comm_type: SERIAL
      serial_config { port: "/dev/ttyACM0" baudrate: 115200 }
    }
    firmware {
      min_proto_version: 1
    }
    channels {
      index: 0
      drive: STEP_DIR
      step_dir {
        max_pulse_rate_hz: 1000
        invert_dir: false
        enable_active_low: true
        # Digital pins on the Uno R3. Do not use 0/1 — those are UART RX/TX
        # for the USB-serial bridge. See firmware/arduino/uno/README.md.
        step_pin: 2
        dir_pin: 3
        enable_pin: 4
        step_pulse_width_us: 20
      }
    }
  }
  actions {
    single_actions {
      node {
        id: 1
        node_type: ACTUATOR_SUBSCRIBER
        qos_setting { depth: 10 }
        subscriptions {
          ros2_data_type: FLOAT32
          topic: "arduino_stepper_1/position"
          normalized: false
        }
      }
      action_type: ACTUATOR
      actuator {
        actuator_name: "arduino_stepper_1"
        id: 1
        motor_type: MOTOR_STEPPER_NEMA17
        board_name: "stepper_bus"
        channel: 0
        physical_lower_limit: 0
        physical_upper_limit: 360
        operational_lower_limit: 0
        operational_upper_limit: 360
        stepper_config {
          # 1.8-degree/step NEMA17 at 1/16 microstepping: 200 * 16 / 360.
          steps_per_degree: 8.888889
          gear_ratio: 1.0
          idle_position: 0
        }
      }
    }
  }
}
