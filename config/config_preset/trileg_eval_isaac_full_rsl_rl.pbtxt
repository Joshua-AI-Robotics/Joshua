# Eval for fully proto-defined trileg (rsl_rl).
# Matches trileg_train_isaac_full.pbtxt.

general {
  operation_mode: MODE_TRAINING
  name: "trileg"
}
ai {
  training {
    environment: TRAINING_ENV_SIMULATION
    method: TRAINING_METHOD_EVAL
    simulator_backend: SIM_BACKEND_ISAAC_SIM
    eval {
      algorithm: "rsl_rl"
      checkpoint_path: "/tmp/joshua_checkpoints/isaac_logs/trileg_full_ppo/model_1499.pt"
      num_episodes: 10
      num_envs: 4
      render: true

      task_config {
        task_name: "trileg_full"
        robot {
          usd_filename: "trileg_isaac.usda"
          init_pos_z: 0.45
          init_joint_pos {
            key: "yaw_.*"
            value: 0.0
          }
          init_joint_pos {
            key: "pitch_.*"
            value: 0.9
          }
          actuator_damping: 15.0
        }
        rewards {
          key: "progress"
          value {
            weight: 1.5
          }
        }
        rewards {
          key: "alive"
          value {
            weight: 0.2
          }
        }
        rewards {
          key: "upright"
          value {
            weight: 0.3
            params {
              key: "threshold"
              value: 0.93
            }
          }
        }
        rewards {
          key: "move_to_target"
          value {
            weight: 0.5
            params {
              key: "threshold"
              value: 0.8
            }
          }
        }
        rewards {
          key: "lin_vel_z"
          value {
            weight: -0.5
          }
        }
        rewards {
          key: "ang_vel_xy"
          value {
            weight: -0.2
          }
        }
        rewards {
          key: "flat_orientation"
          value {
            weight: -0.5
          }
        }
        rewards {
          key: "action_rate"
          value {
            weight: -0.05
          }
        }
        rewards {
          key: "joint_vel"
          value {
            weight: -0.005
          }
        }
        rewards {
          key: "action_l2"
          value {
            weight: -0.01
          }
        }
        rewards {
          key: "energy"
          value {
            weight: -0.05
            gear_ratios {
              key: ".*"
              value: 1.0
            }
          }
        }
        rewards {
          key: "joint_pos_limits"
          value {
            weight: -0.1
            gear_ratios {
              key: ".*"
              value: 1.0
            }
          }
        }
        observations {
          key: "base_height"
          value {}
        }
        observations {
          key: "base_lin_vel"
          value {}
        }
        observations {
          key: "base_ang_vel"
          value {}
        }
        observations {
          key: "base_yaw_roll"
          value {}
        }
        observations {
          key: "base_angle_to_target"
          value {}
        }
        observations {
          key: "base_up_proj"
          value {}
        }
        observations {
          key: "base_heading_proj"
          value {}
        }
        observations {
          key: "joint_pos_norm"
          value {}
        }
        observations {
          key: "joint_vel_rel"
          value {
            params {
              key: "scale"
              value: 0.2
            }
          }
        }
        observations {
          key: "body_forces"
          value {
            body_names: "shin_a"
            body_names: "shin_b"
            body_names: "shin_c"
            params {
              key: "scale"
              value: 0.1
            }
          }
        }
        observations {
          key: "actions"
          value {}
        }
      }

      network {
        actor_hidden_dims: 256
        actor_hidden_dims: 128
        actor_hidden_dims: 64
        critic_hidden_dims: 256
        critic_hidden_dims: 128
        critic_hidden_dims: 64
        activation: "elu"
        init_noise_std: 1.0
      }
      sim_physics {
        decimation: 2
        episode_length_s: 16.0
        sim_dt: 0.00833
        action_scale: 3.0
        env_spacing: 4.0
        terrain_friction: 1.0
        bounce_threshold_velocity: 0.2
      }
      termination {
        min_root_height: 0.08
      }
      reset {
        joint_pos_range_min: -0.1
        joint_pos_range_max: 0.1
        joint_vel_range_min: -0.05
        joint_vel_range_max: 0.05
      }
    }
  }
}
