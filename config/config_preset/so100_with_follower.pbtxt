general{
  operation_mode: MODE_TELEOPERATE
}
robot {
  name: "so100"
  id: 1
  robot_type: MANIPULATOR_ARM

  actions {
    single_actions {
      node_id: 1
      subscribe_topic: "sts3215_encoder_1"
      action_type: ACTUATOR
      actuator {
        actuator_name: "sts3215_servo_1"
        id: 1
        actuator_type: STS3215_SERVO
        comm_type: SERIAL
        physical_lower_limit: 0
        physical_upper_limit: 4095
        operational_lower_limit: 973
        operational_upper_limit: 3034
        serial_config {
          id: 1
          port: "/dev/ttyACM0"
          baudrate: 1000000
        }
        sts3215_config {
          servo_id: 1
          move_time_in_ms: 40
          move_speed: 3000
          idle_position: 2070
        }
      }
    }
