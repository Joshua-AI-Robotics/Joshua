general{
  operation_mode: MODE_TRAINING
}
robot {
  name: "so100"
  id: 1
  robot_type: MANIPULATOR_ARM

  perceptions {
    
    single_perceptions {
      node_id: 1
      publish_topic: "sts3215_encoder_1"
      perception_type: ENCODER
      encoder {
        encoder_name: "sts3215_encoder_1"
        id: 1
        encoder_type: STS3215_ENCODER
        comm_type: SERIAL
        operational_lower_limit: 1147
        operational_upper_limit: 3154
        encoder_data_mode: ENCODER_DATA_MODE_NORMALIZED_RADIAN
        serial_config {
          id: 1
          port: "/dev/ttyACM1"
          baudrate: 1000000
        }
        sts3215_encoder_config {
          servo_id: 1          
        }
      }
    }
