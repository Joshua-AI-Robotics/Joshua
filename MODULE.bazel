module(
    name = "project_joshua",
    version = "0.1.0",
)

bazel_dep(name = "rules_cc", version = "0.1.1")
bazel_dep(name = "rules_python", version = "0.40.0")
bazel_dep(name = "rules_proto", version = "7.0.2")
bazel_dep(name = "rules_pkg", version = "0.10.1")
bazel_dep(name = "protobuf", version = "29.0")
bazel_dep(name = "abseil-cpp", version = "20240722.0")
bazel_dep(name = "pybind11_bazel", version = "2.13.6")
bazel_dep(name = "boost.asio", version = "1.83.0.bcr.1")
bazel_dep(name = "gflags", version = "2.2.2")
bazel_dep(name = "glog", version = "0.7.1")
bazel_dep(name = "platforms", version = "0.0.8")

# Hermetic LLVM toolchain for Linux AArch64 (Jetson Orin Nano)
bazel_dep(name = "toolchains_llvm_bootstrapped", version = "0.2.4")
register_toolchains(
    "@toolchains_llvm_bootstrapped//toolchain:linux_aarch64",
)

# ROS2 Bazel rules - local copy
local_path_override(
    module_name = "com_github_mvukov_rules_ros2",
    path = "external/rules_ros2",
)

bazel_dep(name = "com_github_mvukov_rules_ros2")

# Use the rules_ros2 extension to load ROS2 repositories
rules_ros2_non_module_deps = use_extension("@com_github_mvukov_rules_ros2//ros2:extensions.bzl", "non_module_deps")
use_repo(
    rules_ros2_non_module_deps,
    "ros2_rclcpp",
    "ros2_common_interfaces",
    "ros2_rclpy",
    "ros2_launch",
    "ros2_launch_ros",
)

python = use_extension("@rules_python//python/extensions:python.bzl", "python")
python.toolchain(
    is_default = True,
    python_version = "3.11",
)

pip = use_extension("@rules_python//python/extensions:pip.bzl", "pip")
pip.parse(
    hub_name = "project_joshua_pip_deps",
    python_version = "3.11",
    requirements_lock = "//:requirements.lock",
)
use_repo(pip, "project_joshua_pip_deps")

# Custom rule for system dependencies
system_libs = use_repo_rule("//:system_deps.bzl", "system_libs_repo")
system_libs(name = "local_deps")