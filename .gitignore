# Bazel outputs
/bazel-*
MODULE.bazel.lock

# IDE-specific files (adjust based on your IDEs)
/.idea/
/.ijwb/
/.aswb/
/.clwb/
/.project
/.classpath
/.settings/
/.factorypath
*.iml
/.vscode/
/.prettierrc

# Local configuration and user-specific files
/.bazelrc.user
/WORKSPACE.user.bzl

# Other common temporary files
*~
.*.swp
/output/

# Python virtual environment
/venv/
.venv/
.cache/

.venv-*/

# Python bytecode and tooling caches
__pycache__/
*.pyc
.pytest_cache/
.mypy_cache/
*.egg-info/

# Node.js
node_modules/

# MuJoCo logs
MUJOCO_LOG.TXT

ui/public/proto-schema*

# Build output
dist/

# PlatformIO firmware build output (firmware/teensy/41/, etc.)
.pio/

# Ignore MAC OS files
.DS_Store

# Firmware-specific ignores
# Toolchain metadata, local build outputs, and third-party archives under firmware/
firmware/**/.metadata/
firmware/**/build/
firmware/**/Debug/
firmware/**/Release/
firmware/**/out/
firmware/**/*.out
firmware/**/*.map
firmware/**/*.mcelf*
firmware/**/*.appimage*
firmware/**/third_party/SOEM-master/
firmware/**/third_party/SOEM-manual-build/
firmware/**/third_party/soem-master.zip
