<mujoco model="ant">
  <compiler angle="degree"/>
  <option timestep="0.01" integrator="Euler"/>

  <default>
    <joint armature="1" damping="1" limited="true"/>
    <geom contype="1" conaffinity="0" condim="3" density="5.0"
          friction="1 0.5 0.5" margin="0.01" rgba="0.8 0.6 0.4 1"/>
  </default>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0"
             width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge"
             rgb1="0.25 0.26 0.25" rgb2="0.22 0.22 0.22"
             markrgb="0.3 0.3 0.3" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true"
              texrepeat="5 5" reflectance="0.2"/>
  </asset>

  <worldbody>
    <light pos="0 0 3" dir="0 0 -1" directional="true"/>
    <geom name="floor" type="plane" size="50 50 0.1" material="groundplane"
          contype="1" conaffinity="1"/>

    <body name="torso" pos="0 0 0.75">
      <freejoint name="root"/>
      <camera name="track" mode="trackcom" pos="0 -4 1.5" xyaxes="1 0 0 0 0 1"/>
      <geom name="torso_geom" type="sphere" size="0.25"/>

      <!-- Front-Left leg -->
      <body name="fl_aux" pos="0 0 0">
        <geom name="fl_aux_geom" type="capsule" size="0.08"
              fromto="0 0 0 0.2 0.2 0"/>
        <body name="fl_leg" pos="0.2 0.2 0">
          <joint name="fl_hip" type="hinge" axis="0 0 1" range="-30 30"/>
          <geom name="fl_leg_geom" type="capsule" size="0.08"
                fromto="0 0 0 0.2 0.2 0"/>
          <body name="fl_foot" pos="0.2 0.2 0">
            <joint name="fl_ankle" type="hinge" axis="-1 1 0" range="30 70"/>
            <geom name="fl_foot_geom" type="capsule" size="0.08"
                  fromto="0 0 0 0.4 0.4 0"/>
          </body>
        </body>
      </body>

      <!-- Front-Right leg -->
      <body name="fr_aux" pos="0 0 0">
        <geom name="fr_aux_geom" type="capsule" size="0.08"
              fromto="0 0 0 -0.2 0.2 0"/>
        <body name="fr_leg" pos="-0.2 0.2 0">
          <joint name="fr_hip" type="hinge" axis="0 0 1" range="-30 30"/>
          <geom name="fr_leg_geom" type="capsule" size="0.08"
                fromto="0 0 0 -0.2 0.2 0"/>
          <body name="fr_foot" pos="-0.2 0.2 0">
            <joint name="fr_ankle" type="hinge" axis="1 1 0" range="-70 -30"/>
            <geom name="fr_foot_geom" type="capsule" size="0.08"
                  fromto="0 0 0 -0.4 0.4 0"/>
          </body>
        </body>
      </body>

      <!-- Back-Left leg -->
      <body name="bl_aux" pos="0 0 0">
        <geom name="bl_aux_geom" type="capsule" size="0.08"
              fromto="0 0 0 -0.2 -0.2 0"/>
        <body name="bl_leg" pos="-0.2 -0.2 0">
          <joint name="bl_hip" type="hinge" axis="0 0 1" range="-30 30"/>
          <geom name="bl_leg_geom" type="capsule" size="0.08"
                fromto="0 0 0 -0.2 -0.2 0"/>
          <body name="bl_foot" pos="-0.2 -0.2 0">
            <joint name="bl_ankle" type="hinge" axis="-1 1 0" range="-70 -30"/>
            <geom name="bl_foot_geom" type="capsule" size="0.08"
                  fromto="0 0 0 -0.4 -0.4 0"/>
          </body>
        </body>
      </body>

      <!-- Back-Right leg -->
      <body name="br_aux" pos="0 0 0">
        <geom name="br_aux_geom" type="capsule" size="0.08"
              fromto="0 0 0 0.2 -0.2 0"/>
        <body name="br_leg" pos="0.2 -0.2 0">
          <joint name="br_hip" type="hinge" axis="0 0 1" range="-30 30"/>
          <geom name="br_leg_geom" type="capsule" size="0.08"
                fromto="0 0 0 0.2 -0.2 0"/>
          <body name="br_foot" pos="0.2 -0.2 0">
            <joint name="br_ankle" type="hinge" axis="1 1 0" range="30 70"/>
            <geom name="br_foot_geom" type="capsule" size="0.08"
                  fromto="0 0 0 0.4 -0.4 0"/>
          </body>
        </body>
      </body>
    </body>
  </worldbody>

  <actuator>
    <motor joint="fl_hip"   gear="150" ctrllimited="true" ctrlrange="-1 1"/>
    <motor joint="fl_ankle" gear="150" ctrllimited="true" ctrlrange="-1 1"/>
    <motor joint="fr_hip"   gear="150" ctrllimited="true" ctrlrange="-1 1"/>
    <motor joint="fr_ankle" gear="150" ctrllimited="true" ctrlrange="-1 1"/>
    <motor joint="bl_hip"   gear="150" ctrllimited="true" ctrlrange="-1 1"/>
    <motor joint="bl_ankle" gear="150" ctrllimited="true" ctrlrange="-1 1"/>
    <motor joint="br_hip"   gear="150" ctrllimited="true" ctrlrange="-1 1"/>
    <motor joint="br_ankle" gear="150" ctrllimited="true" ctrlrange="-1 1"/>
  </actuator>
</mujoco>
