<mujoco model="so_arm100 pick-and-place">
  <include file="so_arm100.xml"/>

  <statistic center="0.1 -0.01 0.05" extent="0.5"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="45" elevation="-20"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3"
      markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.2"/>
    <material name="object_mat" rgba="0.9 0.2 0.2 1"/>
    <material name="target_mat" rgba="0.2 0.9 0.2 0.4"/>
  </asset>

  <worldbody>
    <light pos="0 0 1.5" dir="0 0 -1" directional="true"/>
    <geom name="floor" size="0 0 0.05" type="plane" material="groundplane"/>

    <!-- Pickable object: small cube with a free joint -->
    <body name="pick_object" pos="0.08 -0.15 0.02">
      <freejoint name="object_joint"/>
      <geom name="object_geom" type="box" size="0.015 0.015 0.015"
            material="object_mat" mass="0.05" condim="4" friction="1 0.5 0.01"/>
    </body>

    <!-- Visual target marker (no collision) -->
    <body name="place_target" pos="0.0 -0.10 0.02" mocap="true">
      <geom name="place_target_geom" type="box" size="0.02 0.02 0.005"
            material="target_mat" contype="0" conaffinity="0"/>
    </body>
  </worldbody>
</mujoco>
