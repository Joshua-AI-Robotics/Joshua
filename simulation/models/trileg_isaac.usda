#usda 1.0
(
    defaultPrim = "Trileg"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "Trileg"
{
    def Xform "torso" (
        apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI", "PhysicsArticulationRootAPI"]
    )
    {
        float physics:density = 5
        bool physics:rigidBodyEnabled = 1
        quatd xformOp:orient = (1, 0, 0, 0)
        double3 xformOp:scale = (1, 1, 1)
        double3 xformOp:translate = (0, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]

        def Sphere "torso_geom" (
            apiSchemas = ["PhysicsCollisionAPI"]
        )
        {
            float3[] extent = [(-0.15, -0.15, -0.15), (0.15, 0.15, 0.15)]
            double radius = 0.15
            color3f[] primvars:displayColor = [(0.2, 0.6, 0.9)]
        }
    }

    # ── Leg A (0 deg, along +X) ──────────────────────────────────────

    def Xform "leg_a" (
        apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
    )
    {
        float physics:density = 5
        bool physics:rigidBodyEnabled = 1
        quatd xformOp:orient = (1, 0, 0, 0)
        double3 xformOp:scale = (1, 1, 1)
        double3 xformOp:translate = (0.15, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]

        def Xform "geom_xform"
        {
            quatd xformOp:orient = (1, 0, 0, 0)
            double3 xformOp:translate = (0.25, 0, 0)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient"]

            def Capsule "leg_geom" (
                apiSchemas = ["PhysicsCollisionAPI"]
            )
            {
                uniform token axis = "X"
                float3[] extent = [(-0.3, -0.05, -0.05), (0.3, 0.05, 0.05)]
                double height = 0.5
                double radius = 0.05
                color3f[] primvars:displayColor = [(0.9, 0.3, 0.1)]
            }
        }
    }

    # ── Leg B (120 deg) ──────────────────────────────────────────────

    def Xform "leg_b" (
        apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
    )
    {
        float physics:density = 5
        bool physics:rigidBodyEnabled = 1
        quatd xformOp:orient = (1, 0, 0, 0)
        double3 xformOp:scale = (1, 1, 1)
        double3 xformOp:translate = (-0.075, 0.1299, 0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]

        def Xform "geom_xform"
        {
            quatd xformOp:orient = (0.5, 0, 0, 0.8660254)
            double3 xformOp:translate = (-0.125, 0.2165, 0)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient"]

            def Capsule "leg_geom" (
                apiSchemas = ["PhysicsCollisionAPI"]
            )
            {
                uniform token axis = "X"
                float3[] extent = [(-0.3, -0.05, -0.05), (0.3, 0.05, 0.05)]
                double height = 0.5
                double radius = 0.05
                color3f[] primvars:displayColor = [(0.1, 0.8, 0.3)]
            }
        }
    }

    # ── Leg C (240 deg) ──────────────────────────────────────────────

    def Xform "leg_c" (
        apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
    )
    {
        float physics:density = 5
        bool physics:rigidBodyEnabled = 1
        quatd xformOp:orient = (1, 0, 0, 0)
        double3 xformOp:scale = (1, 1, 1)
        double3 xformOp:translate = (-0.075, -0.1299, 0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]

        def Xform "geom_xform"
        {
            quatd xformOp:orient = (0.5, 0, 0, -0.8660254)
            double3 xformOp:translate = (-0.125, -0.2165, 0)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient"]

            def Capsule "leg_geom" (
                apiSchemas = ["PhysicsCollisionAPI"]
            )
            {
                uniform token axis = "X"
                float3[] extent = [(-0.3, -0.05, -0.05), (0.3, 0.05, 0.05)]
                double height = 0.5
                double radius = 0.05
                color3f[] primvars:displayColor = [(0.8, 0.8, 0.1)]
            }
        }
    }

    # ── Joints ───────────────────────────────────────────────────────
    #
    # Each hip is a revolute joint whose axis is HORIZONTAL and
    # perpendicular to the leg direction, so the leg swings up/down.
    #
    #   Leg A  direction (+1,  0,  0)  →  joint axis  Y     (0, 1, 0)
    #   Leg B  direction (-½, +√3/2, 0) →  joint axis  (-√3/2, -½, 0)
    #   Leg C  direction (-½, -√3/2, 0) →  joint axis  (+√3/2, -½, 0)
    #
    # physics:axis = "X" everywhere; localRot maps local-X to the
    # desired world-space axis.

    def Scope "joints"
    {
        def PhysicsRevoluteJoint "hip_a"
        {
            uniform token physics:axis = "X"
            rel physics:body0 = </Trileg/torso>
            rel physics:body1 = </Trileg/leg_a>
            point3f physics:localPos0 = (0.15, 0, 0)
            point3f physics:localPos1 = (0, 0, 0)
            quatf physics:localRot0 = (0.7071068, 0, 0, 0.7071068)
            quatf physics:localRot1 = (0.7071068, 0, 0, 0.7071068)
            float physics:lowerLimit = -20
            float physics:upperLimit = 90
        }

        def PhysicsRevoluteJoint "hip_b"
        {
            uniform token physics:axis = "X"
            rel physics:body0 = </Trileg/torso>
            rel physics:body1 = </Trileg/leg_b>
            point3f physics:localPos0 = (-0.075, 0.1299, 0)
            point3f physics:localPos1 = (0, 0, 0)
            quatf physics:localRot0 = (-0.2588190, 0, 0, 0.9659258)
            quatf physics:localRot1 = (-0.2588190, 0, 0, 0.9659258)
            float physics:lowerLimit = -20
            float physics:upperLimit = 90
        }

        def PhysicsRevoluteJoint "hip_c"
        {
            uniform token physics:axis = "X"
            rel physics:body0 = </Trileg/torso>
            rel physics:body1 = </Trileg/leg_c>
            point3f physics:localPos0 = (-0.075, -0.1299, 0)
            point3f physics:localPos1 = (0, 0, 0)
            quatf physics:localRot0 = (0.9659258, 0, 0, -0.2588190)
            quatf physics:localRot1 = (0.9659258, 0, 0, -0.2588190)
            float physics:lowerLimit = -20
            float physics:upperLimit = 90
        }
    }
}
