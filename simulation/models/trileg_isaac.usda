#usda 1.0
(
    defaultPrim = "Trileg"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "Trileg"
{
    def Xform "torso" (
        apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI", "PhysicsArticulationRootAPI"]
    )
    {
        float physics:density = 5
        bool physics:rigidBodyEnabled = 1
        quatd xformOp:orient = (1, 0, 0, 0)
        double3 xformOp:scale = (1, 1, 1)
        double3 xformOp:translate = (0, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]

        def Sphere "torso_geom" (
            apiSchemas = ["PhysicsCollisionAPI"]
        )
        {
            float3[] extent = [(-0.15, -0.15, -0.15), (0.15, 0.15, 0.15)]
            double radius = 0.15
            color3f[] primvars:displayColor = [(0.2, 0.6, 0.9)]
        }
    }

    # ── Leg A (0 deg, along +X) ──────────────────────────────────────
    #
    # Two bodies per leg:
    #   thigh -- short upper segment, attached to torso via yaw joint
    #   shin  -- longer lower segment, attached to thigh via pitch joint

    def Xform "thigh_a" (
        apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
    )
    {
        float physics:density = 5
        bool physics:rigidBodyEnabled = 1
        quatd xformOp:orient = (1, 0, 0, 0)
        double3 xformOp:scale = (1, 1, 1)
        double3 xformOp:translate = (0.15, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]

        def Xform "geom_xform"
        {
            quatd xformOp:orient = (1, 0, 0, 0)
            double3 xformOp:translate = (0.06, 0, 0)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient"]

            def Capsule "thigh_geom" (
                apiSchemas = ["PhysicsCollisionAPI"]
            )
            {
                uniform token axis = "X"
                float3[] extent = [(-0.1, -0.04, -0.04), (0.1, 0.04, 0.04)]
                double height = 0.12
                double radius = 0.04
                color3f[] primvars:displayColor = [(0.7, 0.25, 0.08)]
            }
        }
    }

    def Xform "shin_a" (
        apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
    )
    {
        float physics:density = 5
        bool physics:rigidBodyEnabled = 1
        quatd xformOp:orient = (1, 0, 0, 0)
        double3 xformOp:scale = (1, 1, 1)
        double3 xformOp:translate = (0.27, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]

        def Xform "geom_xform"
        {
            quatd xformOp:orient = (1, 0, 0, 0)
            double3 xformOp:translate = (0.19, 0, 0)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient"]

            def Capsule "shin_geom" (
                apiSchemas = ["PhysicsCollisionAPI"]
            )
            {
                uniform token axis = "X"
                float3[] extent = [(-0.24, -0.05, -0.05), (0.24, 0.05, 0.05)]
                double height = 0.38
                double radius = 0.05
                color3f[] primvars:displayColor = [(0.9, 0.3, 0.1)]
            }
        }
    }

    # ── Leg B (120 deg) ──────────────────────────────────────────────

    def Xform "thigh_b" (
        apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
    )
    {
        float physics:density = 5
        bool physics:rigidBodyEnabled = 1
        quatd xformOp:orient = (1, 0, 0, 0)
        double3 xformOp:scale = (1, 1, 1)
        double3 xformOp:translate = (-0.075, 0.1299, 0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]

        def Xform "geom_xform"
        {
            quatd xformOp:orient = (0.5, 0, 0, 0.8660254)
            double3 xformOp:translate = (-0.03, 0.052, 0)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient"]

            def Capsule "thigh_geom" (
                apiSchemas = ["PhysicsCollisionAPI"]
            )
            {
                uniform token axis = "X"
                float3[] extent = [(-0.1, -0.04, -0.04), (0.1, 0.04, 0.04)]
                double height = 0.12
                double radius = 0.04
                color3f[] primvars:displayColor = [(0.08, 0.6, 0.25)]
            }
        }
    }

    def Xform "shin_b" (
        apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
    )
    {
        float physics:density = 5
        bool physics:rigidBodyEnabled = 1
        quatd xformOp:orient = (1, 0, 0, 0)
        double3 xformOp:scale = (1, 1, 1)
        double3 xformOp:translate = (-0.135, 0.234, 0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]

        def Xform "geom_xform"
        {
            quatd xformOp:orient = (0.5, 0, 0, 0.8660254)
            double3 xformOp:translate = (-0.095, 0.1645, 0)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient"]

            def Capsule "shin_geom" (
                apiSchemas = ["PhysicsCollisionAPI"]
            )
            {
                uniform token axis = "X"
                float3[] extent = [(-0.24, -0.05, -0.05), (0.24, 0.05, 0.05)]
                double height = 0.38
                double radius = 0.05
                color3f[] primvars:displayColor = [(0.1, 0.8, 0.3)]
            }
        }
    }

    # ── Leg C (240 deg) ──────────────────────────────────────────────

    def Xform "thigh_c" (
        apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
    )
    {
        float physics:density = 5
        bool physics:rigidBodyEnabled = 1
        quatd xformOp:orient = (1, 0, 0, 0)
        double3 xformOp:scale = (1, 1, 1)
        double3 xformOp:translate = (-0.075, -0.1299, 0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]

        def Xform "geom_xform"
        {
            quatd xformOp:orient = (0.5, 0, 0, -0.8660254)
            double3 xformOp:translate = (-0.03, -0.052, 0)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient"]

            def Capsule "thigh_geom" (
                apiSchemas = ["PhysicsCollisionAPI"]
            )
            {
                uniform token axis = "X"
                float3[] extent = [(-0.1, -0.04, -0.04), (0.1, 0.04, 0.04)]
                double height = 0.12
                double radius = 0.04
                color3f[] primvars:displayColor = [(0.6, 0.6, 0.08)]
            }
        }
    }

    def Xform "shin_c" (
        apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
    )
    {
        float physics:density = 5
        bool physics:rigidBodyEnabled = 1
        quatd xformOp:orient = (1, 0, 0, 0)
        double3 xformOp:scale = (1, 1, 1)
        double3 xformOp:translate = (-0.135, -0.234, 0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]

        def Xform "geom_xform"
        {
            quatd xformOp:orient = (0.5, 0, 0, -0.8660254)
            double3 xformOp:translate = (-0.095, -0.1645, 0)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient"]

            def Capsule "shin_geom" (
                apiSchemas = ["PhysicsCollisionAPI"]
            )
            {
                uniform token axis = "X"
                float3[] extent = [(-0.24, -0.05, -0.05), (0.24, 0.05, 0.05)]
                double height = 0.38
                double radius = 0.05
                color3f[] primvars:displayColor = [(0.8, 0.8, 0.1)]
            }
        }
    }

    # ── Joints ───────────────────────────────────────────────────────
    #
    # 2 DOF per leg (6 DOF total):
    #
    #   yaw_X   (torso → thigh_X)  rotates around Z (vertical)
    #           Sweeps the leg forward / backward in the horizontal plane.
    #
    #   pitch_X (thigh_X → shin_X) rotates around horizontal axis
    #           perpendicular to the leg direction, swinging shin up / down.
    #
    # physics:axis = "X" everywhere; localRot maps local-X to the
    # desired world-space axis.
    #
    #   Yaw joints:  local X → world Z   via quat (0.707, 0, -0.707, 0)
    #
    #   Pitch axes (perpendicular to leg direction, horizontal):
    #     Leg A  dir (+1, 0, 0)          → pitch axis Y   quat (0.707, 0, 0, 0.707)
    #     Leg B  dir (-½, +√3/2, 0)      → pitch axis 210° quat (-0.259, 0, 0, 0.966)
    #     Leg C  dir (-½, -√3/2, 0)      → pitch axis 330° quat (0.966, 0, 0, -0.259)

    def Scope "joints"
    {
        # ── Leg A joints ──────────────────────────────────────────

        def PhysicsRevoluteJoint "yaw_a"
        {
            uniform token physics:axis = "X"
            rel physics:body0 = </Trileg/torso>
            rel physics:body1 = </Trileg/thigh_a>
            point3f physics:localPos0 = (0.15, 0, 0)
            point3f physics:localPos1 = (0, 0, 0)
            quatf physics:localRot0 = (0.7071068, 0, -0.7071068, 0)
            quatf physics:localRot1 = (0.7071068, 0, -0.7071068, 0)
            float physics:lowerLimit = -45
            float physics:upperLimit = 45
        }

        def PhysicsRevoluteJoint "pitch_a"
        {
            uniform token physics:axis = "X"
            rel physics:body0 = </Trileg/thigh_a>
            rel physics:body1 = </Trileg/shin_a>
            point3f physics:localPos0 = (0.12, 0, 0)
            point3f physics:localPos1 = (0, 0, 0)
            quatf physics:localRot0 = (0.7071068, 0, 0, 0.7071068)
            quatf physics:localRot1 = (0.7071068, 0, 0, 0.7071068)
            float physics:lowerLimit = -20
            float physics:upperLimit = 90
        }

        # ── Leg B joints ──────────────────────────────────────────

        def PhysicsRevoluteJoint "yaw_b"
        {
            uniform token physics:axis = "X"
            rel physics:body0 = </Trileg/torso>
            rel physics:body1 = </Trileg/thigh_b>
            point3f physics:localPos0 = (-0.075, 0.1299, 0)
            point3f physics:localPos1 = (0, 0, 0)
            quatf physics:localRot0 = (0.7071068, 0, -0.7071068, 0)
            quatf physics:localRot1 = (0.7071068, 0, -0.7071068, 0)
            float physics:lowerLimit = -45
            float physics:upperLimit = 45
        }

        def PhysicsRevoluteJoint "pitch_b"
        {
            uniform token physics:axis = "X"
            rel physics:body0 = </Trileg/thigh_b>
            rel physics:body1 = </Trileg/shin_b>
            point3f physics:localPos0 = (-0.06, 0.104, 0)
            point3f physics:localPos1 = (0, 0, 0)
            quatf physics:localRot0 = (-0.2588190, 0, 0, 0.9659258)
            quatf physics:localRot1 = (-0.2588190, 0, 0, 0.9659258)
            float physics:lowerLimit = -20
            float physics:upperLimit = 90
        }

        # ── Leg C joints ──────────────────────────────────────────

        def PhysicsRevoluteJoint "yaw_c"
        {
            uniform token physics:axis = "X"
            rel physics:body0 = </Trileg/torso>
            rel physics:body1 = </Trileg/thigh_c>
            point3f physics:localPos0 = (-0.075, -0.1299, 0)
            point3f physics:localPos1 = (0, 0, 0)
            quatf physics:localRot0 = (0.7071068, 0, -0.7071068, 0)
            quatf physics:localRot1 = (0.7071068, 0, -0.7071068, 0)
            float physics:lowerLimit = -45
            float physics:upperLimit = 45
        }

        def PhysicsRevoluteJoint "pitch_c"
        {
            uniform token physics:axis = "X"
            rel physics:body0 = </Trileg/thigh_c>
            rel physics:body1 = </Trileg/shin_c>
            point3f physics:localPos0 = (-0.06, -0.104, 0)
            point3f physics:localPos1 = (0, 0, 0)
            quatf physics:localRot0 = (0.9659258, 0, 0, -0.2588190)
            quatf physics:localRot1 = (0.9659258, 0, 0, -0.2588190)
            float physics:lowerLimit = -20
            float physics:upperLimit = 90
        }
    }
}
