#usda 1.0
(
    defaultPrim = "Bileg"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "Bileg"
{
    def Xform "torso" (
        apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI", "PhysicsArticulationRootAPI"]
    )
    {
        float physics:density = 5
        bool physics:rigidBodyEnabled = 1
        quatd xformOp:orient = (1, 0, 0, 0)
        double3 xformOp:scale = (1, 1, 1)
        double3 xformOp:translate = (0, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]

        def Cube "body_geom" (
            apiSchemas = ["PhysicsCollisionAPI"]
        )
        {
            double size = 1
            double3 xformOp:scale = (0.2, 0.36, 0.2)
            uniform token[] xformOpOrder = ["xformOp:scale"]
            float3[] extent = [(-0.5, -0.5, -0.5), (0.5, 0.5, 0.5)]
            color3f[] primvars:displayColor = [(0.3, 0.5, 0.8)]
        }
    }

    def Xform "left_wheel" (
        apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
    )
    {
        float physics:density = 5
        bool physics:rigidBodyEnabled = 1
        quatd xformOp:orient = (1, 0, 0, 0)
        double3 xformOp:scale = (1, 1, 1)
        double3 xformOp:translate = (-0.18, 0.18, -0.05)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]

        def Xform "geom_xform"
        {
            quatd xformOp:orient = (1, 0, 0, 0)
            double3 xformOp:translate = (0, 0, 0)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient"]

            def Cylinder "wheel_geom" (
                apiSchemas = ["PhysicsCollisionAPI"]
            )
            {
                uniform token axis = "X"
                float3[] extent = [(-0.02, -0.1, -0.1), (0.02, 0.1, 0.1)]
                double height = 0.04
                double radius = 0.1
                color3f[] primvars:displayColor = [(0.9, 0.3, 0.1)]
            }
        }
    }

    def Xform "right_wheel" (
        apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
    )
    {
        float physics:density = 5
        bool physics:rigidBodyEnabled = 1
        quatd xformOp:orient = (1, 0, 0, 0)
        double3 xformOp:scale = (1, 1, 1)
        double3 xformOp:translate = (0.18, 0.18, -0.05)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]

        def Xform "geom_xform"
        {
            quatd xformOp:orient = (1, 0, 0, 0)
            double3 xformOp:translate = (0, 0, 0)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient"]

            def Cylinder "wheel_geom" (
                apiSchemas = ["PhysicsCollisionAPI"]
            )
            {
                uniform token axis = "X"
                float3[] extent = [(-0.02, -0.1, -0.1), (0.02, 0.1, 0.1)]
                double height = 0.04
                double radius = 0.1
                color3f[] primvars:displayColor = [(0.9, 0.3, 0.1)]
            }
        }
    }

    def Xform "rear_caster_fork" (
        apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
    )
    {
        float physics:density = 5
        bool physics:rigidBodyEnabled = 1
        quatd xformOp:orient = (1, 0, 0, 0)
        double3 xformOp:scale = (1, 1, 1)
        double3 xformOp:translate = (0, -0.22, -0.07)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]

        def Capsule "fork_geom" (
            apiSchemas = ["PhysicsCollisionAPI"]
        )
        {
            uniform token axis = "Z"
            float3[] extent = [(-0.01, -0.01, -0.03), (0.01, 0.01, 0.03)]
            double height = 0.04
            double radius = 0.01
            color3f[] primvars:displayColor = [(0.5, 0.5, 0.5)]
        }
    }

    def Xform "rear_wheel" (
        apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
    )
    {
        float physics:density = 5
        bool physics:rigidBodyEnabled = 1
        quatd xformOp:orient = (1, 0, 0, 0)
        double3 xformOp:scale = (1, 1, 1)
        double3 xformOp:translate = (0, -0.22, -0.115)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]

        def Cylinder "wheel_geom" (
            apiSchemas = ["PhysicsCollisionAPI"]
        )
        {
            uniform token axis = "X"
            float3[] extent = [(-0.01, -0.035, -0.035), (0.01, 0.035, 0.035)]
            double height = 0.02
            double radius = 0.035
            color3f[] primvars:displayColor = [(0.7, 0.7, 0.7)]
        }
    }

    def Scope "joints"
    {
        def PhysicsRevoluteJoint "left_motor" (
            apiSchemas = ["PhysxJointAPI"]
        )
        {
            uniform token physics:axis = "X"
            rel physics:body0 = </Bileg/torso>
            rel physics:body1 = </Bileg/left_wheel>
            point3f physics:localPos0 = (-0.18, 0.18, -0.05)
            point3f physics:localPos1 = (0, 0, 0)
            quatf physics:localRot0 = (1, 0, 0, 0)
            quatf physics:localRot1 = (1, 0, 0, 0)
            float physxJoint:maxJointVelocity = 10.0
        }

        def PhysicsRevoluteJoint "right_motor" (
            apiSchemas = ["PhysxJointAPI"]
        )
        {
            uniform token physics:axis = "X"
            rel physics:body0 = </Bileg/torso>
            rel physics:body1 = </Bileg/right_wheel>
            point3f physics:localPos0 = (0.18, 0.18, -0.05)
            point3f physics:localPos1 = (0, 0, 0)
            quatf physics:localRot0 = (1, 0, 0, 0)
            quatf physics:localRot1 = (1, 0, 0, 0)
            float physxJoint:maxJointVelocity = 10.0
        }

        def PhysicsRevoluteJoint "caster_swivel" (
            apiSchemas = ["PhysxJointAPI"]
        )
        {
            uniform token physics:axis = "Z"
            rel physics:body0 = </Bileg/torso>
            rel physics:body1 = </Bileg/rear_caster_fork>
            point3f physics:localPos0 = (0, -0.22, -0.07)
            point3f physics:localPos1 = (0, 0, 0)
            quatf physics:localRot0 = (1, 0, 0, 0)
            quatf physics:localRot1 = (1, 0, 0, 0)
        }

        def PhysicsRevoluteJoint "caster_axle" (
            apiSchemas = ["PhysxJointAPI"]
        )
        {
            uniform token physics:axis = "X"
            rel physics:body0 = </Bileg/rear_caster_fork>
            rel physics:body1 = </Bileg/rear_wheel>
            point3f physics:localPos0 = (0, 0, -0.045)
            point3f physics:localPos1 = (0, 0, 0)
            quatf physics:localRot0 = (1, 0, 0, 0)
            quatf physics:localRot1 = (1, 0, 0, 0)
        }
