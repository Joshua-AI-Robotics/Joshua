def _system_libs_repo_impl(ctx):
    """Implementation of the system_libs_repo rule.
    
    Supports cross-compilation by checking for ROS2_SYSROOT environment variable.
    If ROS2_SYSROOT is set, it will use that as the base path for ROS2 libraries.
    Otherwise, it uses the host system paths (/usr, /opt/ros/humble).
    """
    # Check for sysroot (for cross-compilation)
    # Note: In Starlark, we can't directly access os.environ
    # The sysroot needs to be passed via repository rule attributes or environment
    # For now, we'll use host system paths
    # To use sysroot, set it via repository_rule environment attribute or use multiarch paths
    
    build_content = """
# AUTOGENERATED by system_libs_repo rule
load("@rules_cc//cc:defs.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])

# Platform selectors for x86_64 vs aarch64
config_setting(
    name = "cpu_x86_64",
    constraint_values = ["@platforms//cpu:x86_64"],
)

config_setting(
    name = "cpu_aarch64",
    constraint_values = ["@platforms//cpu:aarch64"],
)

# =============================================================================
# ROS2 System Libraries with Cross-Compilation Support
# =============================================================================
# These libraries support both native (x86_64) and cross-compilation (aarch64)
# For cross-compilation, set ROS2_SYSROOT environment variable to point to 
# arm64 sysroot (e.g., /path/to/sysroot or use multiarch paths)

# Note: These helper functions are commented out as they use Python imports
# which are not supported in Starlark. The library paths are handled directly
# in the select() statements below.

# ROS2 Core Libraries
cc_library(
    name = "rclcpp",
    hdrs = glob([
        "opt/ros/humble/include/rclcpp/**/*.h",
        "opt/ros/humble/include/rclcpp/**/*.hpp",
    ], allow_empty = True),
    strip_include_prefix = "opt/ros/humble/include/rclcpp",
    linkopts = select({
        ":cpu_x86_64": [
            "-L/opt/ros/humble/lib",
            "-L/usr/lib/x86_64-linux-gnu",
            "-Wl,-rpath,/opt/ros/humble/lib",
            "-lrclcpp",
        ],
        ":cpu_aarch64": [
            "-L/opt/ros/humble/lib",
            "-L/usr/lib/aarch64-linux-gnu",
            "-Wl,-rpath,/opt/ros/humble/lib",
            "-lrclcpp",
        ],
        "//conditions:default": [
            "-L/opt/ros/humble/lib",
            "-lrclcpp",
        ],
    }),
    deps = [
        ":rcl",
        ":rcpputils",
        ":rcutils",
        ":rmw",
        ":rosidl_runtime_cpp",
        ":rosidl_typesupport_cpp",
        ":rosidl_typesupport_c",
        ":builtin_interfaces",
        ":rcl_interfaces",
        ":tracetools",
        ":libstatistics_collector",
        ":rosgraph_msgs",
        ":ament_index_cpp",
    ],
)

cc_library(
    name = "ament_index_cpp",
    hdrs = glob([
        "opt/ros/humble/include/ament_index_cpp/**/*.hpp",
        "opt/ros/humble/include/ament_index_cpp/**/*.h",
    ], allow_empty = True),
    strip_include_prefix = "opt/ros/humble/include/ament_index_cpp",
    linkopts = select({
        ":cpu_x86_64": [
            "-L/opt/ros/humble/lib",
            "-L/usr/lib/x86_64-linux-gnu",
            "-Wl,-rpath,/opt/ros/humble/lib",
            "-lament_index_cpp",
        ],
        ":cpu_aarch64": [
            "-L/opt/ros/humble/lib",
