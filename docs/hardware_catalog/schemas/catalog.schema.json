              "profile": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096,
                "pattern": "^[^\\x00-\\x1f]*$"
              },
              "artifact": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4096,
                    "pattern": "^[^\\x00-\\x1f]*$"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "sha256": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "toolchain": {
                "type": "object",
                "additionalProperties": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4096,
                  "pattern": "^[^\\x00-\\x1f]*$"
                }
              }
            },
            "required": [
              "subject",
              "profile",
              "artifact",
              "sha256",
              "toolchain"
            ],
            "additionalProperties": false
          },
          "minItems": 0,
          "uniqueItems": true,
          "maxItems": 256
        },
        "configuration": {
          "type": "array",
