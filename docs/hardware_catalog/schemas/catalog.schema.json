{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:joshua:hardware-catalog:1",
  "title": "Joshua hardware catalog record",
  "$defs": {
    "person": {
      "type": "object",
      "properties": {
        "provider": {
          "enum": [
            "github",
            "other"
          ]
        },
        "username": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "^(?=.*\\S)[^\\x00-\\x1f]*$"
        },
        "organization": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096,
              "pattern": "^[^\\x00-\\x1f]*$"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "provider",
        "username",
        "organization"
      ],
      "additionalProperties": false
    },
    "artifact": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{0,127}$"
        },
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "^[^\\x00-\\x1f]*$"
        },
        "sha256": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "media_type": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "^[^\\x00-\\x1f]*$"
        },
        "availability": {
          "enum": [
            "retained",
            "not_retained",
            "external"
          ]
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "^[^\\x00-\\x1f]*$"
        }
      },
      "required": [
        "id",
        "path",
        "sha256",
        "media_type",
        "availability",
        "description"
      ],
      "additionalProperties": false
    },
    "check": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{0,127}$"
        },
        "capability": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{0,127}$"
        },
        "metric": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "^[^\\x00-\\x1f]*$"
        },
        "unit": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "^[^\\x00-\\x1f]*$"
        },
        "operator": {
          "enum": [
            "eq",
            "gte",
            "lte",
            "between"
          ]
        },
        "expected": {
          "type": [
            "number",
            "boolean",
            "string",
            "array"
          ]
        },
        "measurement_method": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "^[^\\x00-\\x1f]*$"
        }
      },
      "required": [
        "id",
        "capability",
        "metric",
        "unit",
        "operator",
        "expected",
        "measurement_method"
      ],
      "additionalProperties": false
    },
    "model": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": 1
        },
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{0,127}$"
        },
        "record_type": {
          "const": "model"
        },
        "kind": {
          "enum": [
            "board",
            "camera",
            "actuator",
            "motor_driver",
            "sensor",
            "transport_adapter",
            "host",
            "power",
            "assembly",
            "other"
          ]
        },
        "manufacturer": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "^[^\\x00-\\x1f]*$"
        },
        "model": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "^[^\\x00-\\x1f]*$"
        },
        "aliases": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096,
            "pattern": "^[^\\x00-\\x1f]*$"
          },
          "minItems": 0,
          "uniqueItems": true,
          "maxItems": 256
        },
        "revisions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096,
            "pattern": "^[^\\x00-\\x1f]*$"
          },
          "minItems": 0,
          "uniqueItems": true,
          "maxItems": 256
        },
        "identifiers": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096,
            "pattern": "^[^\\x00-\\x1f]*$"
          },
          "maxProperties": 32
        },
        "capabilities": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,127}$"
          },
          "minItems": 1,
          "uniqueItems": true,
          "maxItems": 256
        },
        "specifications": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096,
                "pattern": "^[^\\x00-\\x1f]*$"
              },
              "value": {
                "type": [
                  "number",
                  "string",
                  "boolean"
                ]
              },
              "unit": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096,
                "pattern": "^[^\\x00-\\x1f]*$"
              },
              "conditions": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096,
                "pattern": "^[^\\x00-\\x1f]*$"
              },
              "provenance": {
                "enum": [
                  "manufacturer",
                  "configured",
                  "measured"
                ]
              },
              "source": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096,
                "pattern": "^[^\\x00-\\x1f]*$"
              }
            },
            "required": [
              "name",
              "value",
              "unit",
              "conditions",
              "provenance",
              "source"
            ],
            "additionalProperties": false
          },
          "minItems": 0,
          "uniqueItems": true,
          "maxItems": 256
        },
        "integration": {
          "type": "object",
          "properties": {
            "status": {
              "enum": [
                "intended",
                "catalogued",
                "unsupported",
                "retired"
              ]
            },
            "driver": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4096,
                  "pattern": "^[^\\x00-\\x1f]*$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "implementations": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*//)[^\\\\\\s]+$",
                "maxLength": 1024
              },
              "minItems": 0,
              "uniqueItems": true,
              "maxItems": 256
            },
            "presets": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*//)[^\\\\\\s]+$",
                "maxLength": 1024
              },
              "minItems": 0,
              "uniqueItems": true,
              "maxItems": 256
            },
            "guide": {
              "type": "string",
              "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*//)[^\\\\\\s]+$",
              "maxLength": 1024
            },
            "support_scope": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096,
              "pattern": "^[^\\x00-\\x1f]*$"
            },
            "legacy_export": {
              "type": "boolean"
            }
          },
          "required": [
            "status",
            "driver",
            "implementations",
            "presets",
            "guide",
            "support_scope",
            "legacy_export"
          ],
          "additionalProperties": false
        },
        "documentation": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096,
            "pattern": "^[^\\x00-\\x1f]*$"
          },
          "minItems": 0,
          "uniqueItems": true,
          "maxItems": 256
        },
        "maintainers": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/person"
          },
          "minItems": 0,
          "uniqueItems": true,
          "maxItems": 256
        },
        "category_details": {
          "type": "object",
          "minProperties": 1
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096,
            "pattern": "^[^\\x00-\\x1f]*$"
          },
          "minItems": 1,
          "uniqueItems": true,
          "maxItems": 256
        },
        "legacy_order": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "schema_version",
        "id",
        "record_type",
        "kind",
        "manufacturer",
        "model",
        "aliases",
        "revisions",
        "identifiers",
        "capabilities",
        "specifications",
        "integration",
        "documentation",
        "maintainers",
        "category_details",
        "limitations",
        "legacy_order"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "board"
              }
            }
          },
          "then": {
            "properties": {
              "category_details": {
                "type": "object",
                "properties": {
                  "mcu": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "transports": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "firmware_guides": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                },
                "required": [
                  "mcu",
                  "transports",
                  "firmware_guides"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "camera"
              }
            }
          },
          "then": {
            "properties": {
              "category_details": {
                "type": "object",
                "properties": {
                  "capture_modes": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "timestamp_semantics": {
                    "type": [
                      "string",
                      "null"
                    ]
                  }
                },
                "required": [
                  "capture_modes",
                  "timestamp_semantics"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "actuator"
              }
            }
          },
          "then": {
            "properties": {
              "category_details": {
                "type": "object",
                "properties": {
                  "units": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "feedback": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "load": {
                    "type": [
                      "string",
                      "null"
                    ]
                  }
                },
                "required": [
                  "units",
                  "feedback",
                  "load"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "motor_driver"
              }
            }
          },
          "then": {
            "properties": {
              "category_details": {
                "type": "object",
                "properties": {
                  "modes": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "electrical_limits": {
                    "type": [
                      "string",
                      "null"
                    ]
                  }
                },
                "required": [
                  "modes",
                  "electrical_limits"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "sensor"
              }
            }
          },
          "then": {
            "properties": {
              "category_details": {
                "type": "object",
                "properties": {
                  "quantity": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "units": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "calibration": {
                    "type": [
                      "string",
                      "null"
                    ]
                  }
                },
                "required": [
                  "quantity",
                  "units",
                  "calibration"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "transport_adapter"
              }
            }
          },
          "then": {
            "properties": {
              "category_details": {
                "type": "object",
                "properties": {
                  "interface": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "chipset": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "topology": {
                    "type": [
                      "string",
                      "null"
                    ]
                  }
                },
                "required": [
                  "interface",
                  "chipset",
                  "topology"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "host"
              }
            }
          },
          "then": {
            "properties": {
              "category_details": {
                "type": "object",
                "properties": {
                  "architecture": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "os_kernel": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "resources": {
                    "type": [
                      "string",
                      "null"
                    ]
                  }
                },
                "required": [
                  "architecture",
                  "os_kernel",
                  "resources"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "power"
              }
            }
          },
          "then": {
            "properties": {
              "category_details": {
                "type": "object",
                "properties": {
                  "voltage": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "current_limit": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "protection": {
                    "type": [
                      "string",
                      "null"
                    ]
                  }
                },
                "required": [
                  "voltage",
                  "current_limit",
                  "protection"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "assembly"
              }
            }
          },
          "then": {
            "properties": {
              "category_details": {
                "type": "object",
                "properties": {
                  "parts": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "topology": {
                    "type": [
                      "string",
                      "null"
                    ]
                  }
                },
                "required": [
                  "parts",
                  "topology"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "other"
              }
            }
          },
          "then": {
            "properties": {
              "category_details": {
                "type": "object",
                "properties": {
                  "description": {
                    "type": [
                      "string",
                      "null"
                    ]
                  }
                },
                "required": [
                  "description"
                ],
                "additionalProperties": false
              }
            }
          }
        }
      ]
    },
    "setup": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": 1
        },
        "id": {
