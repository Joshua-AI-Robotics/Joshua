          "minItems": 1,
          "uniqueItems": true,
          "maxItems": 256
        },
        "topology": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "^[^\\x00-\\x1f]*$"
        },
        "wiring": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096,
            "pattern": "^[^\\x00-\\x1f]*$"
          },
          "minItems": 0,
          "uniqueItems": true,
          "maxItems": 256
        },
        "power": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "^[^\\x00-\\x1f]*$"
        },
        "firmware": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "subject": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_-]{0,127}$"
