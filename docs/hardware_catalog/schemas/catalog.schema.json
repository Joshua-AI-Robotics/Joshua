            "additionalProperties": false
          },
          "minItems": 0,
          "uniqueItems": true,
          "maxItems": 256
        },
        "environment": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096,
            "pattern": "^[^\\x00-\\x1f]*$"
          },
          "minProperties": 1
        },
        "calibration": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096,
            "pattern": "^[^\\x00-\\x1f]*$"
          },
          "minItems": 0,
          "uniqueItems": true,
          "maxItems": 256
        },
        "conditions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096,
            "pattern": "^[^\\x00-\\x1f]*$"
          },
          "minItems": 0,
          "uniqueItems": true,
          "maxItems": 256
        },
        "unknowns": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096,
            "pattern": "^[^\\x00-\\x1f]*$"
          }
        }
      },
      "required": [
        "schema_version",
        "id",
        "record_type",
        "subjects",
        "topology",
        "wiring",
        "power",
        "firmware",
        "configuration",
        "environment",
        "calibration",
        "conditions",
        "unknowns"
      ],
      "additionalProperties": false
    },
    "specification": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": 1
        },
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{0,127}$"
        },
        "record_type": {
          "const": "specification"
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "^[^\\x00-\\x1f]*$"
        },
        "kinds": {
          "type": "array",
          "items": {
