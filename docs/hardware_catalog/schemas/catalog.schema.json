        },
        "subjects": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "role": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_-]{0,127}$"
              },
              "hardware_id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_-]{0,127}$"
              },
              "unit_alias": {
