{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Joshua device software record",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{0,127}$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "^[^\\x00-\\x1f]*$"
    },
    "vendor": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "^[^\\x00-\\x1f]*$"
    },
    "category": {
      "enum": [
        "Device drivers and SDKs",
        "Device communication",
        "Sensor capture",
        "Hardware control"
      ]
    },
    "source_url": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://"
    },
    "aliases": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4096,
        "pattern": "^[^\\x00-\\x1f]*$"
      },
      "uniqueItems": true,
      "maxItems": 256
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "^[^\\x00-\\x1f]*$"
    },
    "snapshot_date": {
      "type": "string",
      "format": "date"
    },
    "integration": {
      "type": "object",
      "properties": {
        "status": {
          "enum": [
            "candidate",
            "integrated",
            "unsupported",
            "retired"
          ]
        },
        "implementation": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*//)[^\\\\\\s]+$"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "status",
        "implementation"
      ],
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "name",
    "vendor",
    "category",
    "source_url",
    "aliases",
    "description",
    "snapshot_date",
    "integration"
  ]
}
