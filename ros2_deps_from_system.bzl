def _ros2_libs_repo_impl(ctx):
    """Implementation of the ros2_libs_repo rule."""
    
    # Get ROS_DISTRO from environment, default to 'humble' if not set
    ros_distro = ctx.os.environ.get("ROS_DISTRO", "humble")
    
    print("Configuring ros2_deps_from_system for ROS_DISTRO: {}".format(ros_distro))

    # Determine if we need new interfaces (Required for Iron/Jazzy+, not in Humble)
    # This list should include all distros newer than Humble
    needs_new_interfaces = ros_distro in ["iron", "jazzy", "rolling"]
    
    # Conditional dependency strings
    service_msgs_dep = '":service_msgs",' if needs_new_interfaces else ""
    type_description_interfaces_dep = '":type_description_interfaces",' if needs_new_interfaces else ""
    rosidl_dynamic_typesupport_dep = '":rosidl_dynamic_typesupport",' if needs_new_interfaces else ""
    
    # Introspection libraries are usually always needed, but were transitive before.
    # Jazzy seems to require them explicitly. We'll add them unconditionally for robustness.
    
    build_content_template = """
# AUTOGENERATED by ros2_libs_repo rule
load("@rules_cc//cc:defs.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])

# Platform selectors for x86_64 vs aarch64
config_setting(
    name = "cpu_x86_64",
    constraint_values = ["@platforms//cpu:x86_64"],
)

config_setting(
    name = "cpu_aarch64",
    constraint_values = ["@platforms//cpu:aarch64"],
)

# =============================================================================
# ROS2 System Libraries with Cross-Compilation Support
# =============================================================================

# ROS2 Core Libraries
cc_library(
    name = "rclcpp",
    hdrs = glob([
        "opt/ros/{distro}/include/rclcpp/**/*.h",
        "opt/ros/{distro}/include/rclcpp/**/*.hpp",
    ], allow_empty = True),
    strip_include_prefix = "opt/ros/{distro}/include/rclcpp",
    linkopts = select({{
        ":cpu_x86_64": [
            "-L/opt/ros/{distro}/lib",
            "-L/usr/lib/x86_64-linux-gnu",
            "-Wl,-rpath,/opt/ros/{distro}/lib",
            "-lrclcpp",
        ],
        ":cpu_aarch64": [
            "-L/opt/ros/{distro}/lib",
            "-L/usr/lib/aarch64-linux-gnu",
            "-Wl,-rpath,/opt/ros/{distro}/lib",
            "-lrclcpp",
        ],
        "//conditions:default": [
            "-L/opt/ros/{distro}/lib",
            "-lrclcpp",
        ],
    }}),
    deps = [
        ":rcl",
        ":rcpputils",
        ":rcutils",
        ":rmw",
        ":rosidl_runtime_cpp",
        ":rosidl_typesupport_cpp",
        ":rosidl_typesupport_c",
        ":rosidl_typesupport_introspection_cpp",
        ":builtin_interfaces",
        ":rcl_interfaces",
        ":tracetools",
        ":libstatistics_collector",
        ":rosgraph_msgs",
        ":ament_index_cpp",
        {service_msgs_dep}
        {type_description_interfaces_dep}
    ],
)

cc_library(
    name = "ament_index_cpp",
    hdrs = glob([
        "opt/ros/{distro}/include/ament_index_cpp/**/*.hpp",
        "opt/ros/{distro}/include/ament_index_cpp/**/*.h",
    ], allow_empty = True),
    strip_include_prefix = "opt/ros/{distro}/include/ament_index_cpp",
    linkopts = select({{
        ":cpu_x86_64": [
            "-L/opt/ros/{distro}/lib",
            "-L/usr/lib/x86_64-linux-gnu",
            "-Wl,-rpath,/opt/ros/{distro}/lib",
            "-lament_index_cpp",
        ],
        ":cpu_aarch64": [
            "-L/opt/ros/{distro}/lib",
