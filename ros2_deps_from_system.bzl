    # Format the template with the correct distro and dependencies
    build_content = build_content_template.format(
        distro=ros_distro,
        service_msgs_dep=service_msgs_dep,
        type_description_interfaces_dep=type_description_interfaces_dep,
        rosidl_dynamic_typesupport_dep=rosidl_dynamic_typesupport_dep
    )
    
    # Create symlinks (delete first if they exist)
    ctx.delete("usr")
    ctx.delete("opt")
    ctx.symlink("/usr", "usr")
    
    # Symlink the specific ROS distro
    # IMPORTANT: We symlink to the path inside the repository so that the globs above work
    # The globs use relative paths like "opt/ros/{distro}/..."
    # So we need to ensure "opt/ros/{distro}" exists in this repository
    
    ros_path = "/opt/ros/{}".format(ros_distro)
    ctx.symlink(ros_path, "opt/ros/{}".format(ros_distro))
    
    ctx.file("BUILD.bazel", build_content)
    ctx.file("WORKSPACE", 'workspace(name = "{}")'.format(ctx.name))

